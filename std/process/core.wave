import("std::process::consts")::{
    PROC_ERR_INTR,
    PROC_WAIT_NOHANG,
    PROC_EXIT_EXEC_FAIL,
    PROC_EXIT_DUP_FAIL,
};
import("std::sys::process")::{
    exit,
    getpid,
    getppid,
    fork,
    execve,
    waitpid,
    kill,
};

#[target(os="linux")]
fun _proc_pid_valid(pid: i64) -> bool {
    return pid >= -2147483648 && pid <= 2147483647;
}
#[target(os="macos")]
fun _proc_pid_valid(pid: i64) -> bool {
    return pid >= -2147483648 && pid <= 2147483647;
}
#[target(os="freebsd")]
fun _proc_pid_valid(pid: i64) -> bool {
    return pid >= -2147483648 && pid <= 2147483647;
}
#[target(os="windows")]
fun _proc_pid_valid(pid: i64) -> bool {
    return true;
}
#[target(os="wasi")]
fun _proc_pid_valid(pid: i64) -> bool {
    return true;
}
#[target(os="none")]
fun _proc_pid_valid(pid: i64) -> bool {
    return true;
}
#[target(os="unknown")]
fun _proc_pid_valid(pid: i64) -> bool {
    return true;
}

pub fun proc_exit(code: i32) -> ! {
    exit(code);
}

pub fun proc_getpid() -> i64 {
    return getpid();
}

pub fun proc_getppid() -> i64 {
    return getppid();
}

pub fun proc_fork() -> i64 {
    return fork();
}

pub fun proc_execve(path: str, argv: ptr<ptr<i8>>, envp: ptr<ptr<i8>>) -> i64 {
    return execve(path, argv, envp);
}

pub fun proc_waitpid_raw(pid: i64, status: ptr<i32>, options: i32) -> i64 {
    if (!_proc_pid_valid(pid)) {
        return -22;
    }
    while (true) {
        var r: i64 = waitpid(pid, status, options);
        if (r == PROC_ERR_INTR) {
            continue;
        }
        return r;
    }

    return -1;
}

pub fun proc_kill(pid: i64, sig: i32) -> i64 {
    if (!_proc_pid_valid(pid)) {
        return -22;
    }
    return kill(pid, sig);
}
