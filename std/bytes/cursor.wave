pub fun bytes_reader_read_be_i16(reader: ptr<ByteReader>, out_value: ptr<i16>) -> i32 {
    if (!_bytes_reader_output_valid(reader, out_value as ptr<u8>, 2)) {
        return BYTES_ERROR_INVALID;
    }
    if (out_value == null) { return BYTES_ERROR_INVALID; }
    var value: u16 = 0;
    var status: i32 = bytes_reader_read_be_u16(reader, &value);
    if (status != BYTES_OK) { return status; }
    deref out_value = value as i16;
    return BYTES_OK;
}

