// Portable readiness helpers. Readability wins over a simultaneous hangup so
// callers can drain final bytes before observing EOF.

import("std::sys::socket")::{
    POLLIN, POLLOUT, POLLERR, POLLHUP, POLLNVAL,
    SOL_SOCKET, SO_ERROR, PollFd, poll, getsockopt,
};
pub import("std::sys::socket")::{PollFd};

pub const NET_POLLIN: i16 = POLLIN;
pub const NET_POLLOUT: i16 = POLLOUT;
pub const NET_POLLERR: i16 = POLLERR;
pub const NET_POLLHUP: i16 = POLLHUP;
pub const NET_POLLNVAL: i16 = POLLNVAL;

pub fun net_poll(fds: ptr<PollFd>, count: i64, timeout_ms: i32) -> i64 {
    if (count < 0 || (fds == null && count > 0)) { return -22; }
    return poll(fds, count, timeout_ms);
}

#[target(os="windows")]
fun _net_poll_fd(fd: i64, events: i16) -> PollFd {
    return PollFd { fd: fd, events: events, revents: 0 };
}
#[target(os="linux")]
fun _net_poll_fd(fd: i64, events: i16) -> PollFd {
    return PollFd { fd: fd as i32, events: events, revents: 0 };
}
#[target(os="macos")]
fun _net_poll_fd(fd: i64, events: i16) -> PollFd {
    return PollFd { fd: fd as i32, events: events, revents: 0 };
}
#[target(os="freebsd")]
fun _net_poll_fd(fd: i64, events: i16) -> PollFd {
    return PollFd { fd: fd as i32, events: events, revents: 0 };
}

// Generic POSIX poll may disable negative entries, but a single-descriptor
// wait must reject them. Winsock handles retain their own provider contract.
#[target(os="linux")]
const NET_POLL_POSIX: bool = true;
#[target(os="macos")]
const NET_POLL_POSIX: bool = true;
#[target(os="freebsd")]
const NET_POLL_POSIX: bool = true;
#[target(os="windows")]
const NET_POLL_POSIX: bool = false;

pub fun net_wait_readable(fd: i64, timeout_ms: i32) -> i64 {
    if (NET_POLL_POSIX && fd < 0) { return -9; }
    var descriptor: PollFd = _net_poll_fd(fd, NET_POLLIN);
    var result: i64 = net_poll(&descriptor, 1, timeout_ms);
    if (result <= 0) { return result; }

    if ((descriptor.revents & NET_POLLIN) != 0) { return 1; }
    if ((descriptor.revents & NET_POLLHUP) != 0) { return 1; }
    if ((descriptor.revents & NET_POLLNVAL) != 0) { return -9; }
    if ((descriptor.revents & NET_POLLERR) != 0) {
        var socket_error: i64 = net_socket_error(fd);
        if (socket_error != 0) { return socket_error; }
        return -5;
    }
    return 0;
}

pub fun net_wait_writable(fd: i64, timeout_ms: i32) -> i64 {
    if (NET_POLL_POSIX && fd < 0) { return -9; }
    var descriptor: PollFd = _net_poll_fd(fd, NET_POLLOUT);
    var result: i64 = net_poll(&descriptor, 1, timeout_ms);
    if (result <= 0) { return result; }

    if ((descriptor.revents & NET_POLLOUT) != 0) { return 1; }
    if ((descriptor.revents & NET_POLLNVAL) != 0) { return -9; }
    if ((descriptor.revents & (NET_POLLERR | NET_POLLHUP)) != 0) {
        var socket_error: i64 = net_socket_error(fd);
        if (socket_error != 0) { return socket_error; }
        return -32;
    }
    return 0;
}

pub fun net_socket_error(fd: i64) -> i64 {
    var value: i32 = 0;
    var size: i32 = 4;
    var result: i64 = getsockopt(fd, SOL_SOCKET, SO_ERROR, &value as ptr<i8>, &size);
    if (result < 0) { return result; }
    if (value == 0) { return 0; }
    return -(value as i64);
}

pub fun net_wait_connected(fd: i64, timeout_ms: i32) -> i64 {
    var ready: i64 = net_wait_writable(fd, timeout_ms);
    if (ready <= 0) { return ready; }
    var socket_error: i64 = net_socket_error(fd);
    if (socket_error < 0) { return socket_error; }
    return 1;
}
