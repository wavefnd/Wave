}

pub fun bytes_write_le_i64(dst: BytesMut, offset: i64, value: i64) -> i32 {
    return bytes_write_le_u64(dst, offset, value as u64);
}

// Copies all src bytes. A failed range check leaves dst unchanged.
pub fun bytes_write_exact(dst: BytesMut, offset: i64, src: Bytes) -> i32 {
    if (src.len < 0 || (src.len > 0 && src.data == null)) {
        return BYTES_ERROR_INVALID;
    }
    var status: i32 = _bytes_check_write(dst, offset, src.len);
    if (status != BYTES_OK) { return status; }
    if (src.len > 0) { mem_move(dst.data + offset, src.data, src.len); }
    return BYTES_OK;
}

import("std::math::float")::{
    float_to_bits_f32, float_to_bits_f64,
};

// Bit-preserving and byte-oriented; an invalid range performs no writes.
pub fun bytes_write_be_f32(dst: BytesMut, offset: i64, value: f32) -> i32 {
    return bytes_write_be_u32(dst, offset, float_to_bits_f32(value));
}

// Bit-preserving and byte-oriented; an invalid range performs no writes.
pub fun bytes_write_be_f64(dst: BytesMut, offset: i64, value: f64) -> i32 {
    return bytes_write_be_u64(dst, offset, float_to_bits_f64(value));
}

// Bit-preserving and byte-oriented; an invalid range performs no writes.
pub fun bytes_write_le_f32(dst: BytesMut, offset: i64, value: f32) -> i32 {
    return bytes_write_le_u32(dst, offset, float_to_bits_f32(value));
}

// Bit-preserving and byte-oriented; an invalid range performs no writes.
pub fun bytes_write_le_f64(dst: BytesMut, offset: i64, value: f64) -> i32 {
    return bytes_write_le_u64(dst, offset, float_to_bits_f64(value));
}

pub fun bytes_write_be_u8(dst: BytesMut, offset: i64, value: u8) -> i32 {
    var status: i32 = _bytes_check_write(dst, offset, 1);
    if (status != BYTES_OK) {
        return status;
    }
    bytes_store_be_u8(dst.data + offset, value as u8);
    return BYTES_OK;
}

