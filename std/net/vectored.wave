// One message-oriented scatter/gather operation over caller-owned slices.

import("std::net::socket_base")::{net_fd_valid};
import("std::sys::vector_io")::{NativeIoSlice, native_io_slice, vector_send, vector_recv, vector_recv_datagram};
import("std::sys::socket")::{MSG_NOSIGNAL};
import("std::net::error")::{NetIoResult, net_io_ok, net_io_eof, net_io_error, NetDatagramResult, net_datagram_error, net_error_none};

pub const NET_IOV_MAX: i32 = 32;

pub struct NetIoSlice {
    data: ptr<u8>;
    length: i64;
}

#[target(os="linux")]
fun _vector_send_flags(flags: i32) -> i32 { return flags | MSG_NOSIGNAL; }
#[target(os="freebsd")]
fun _vector_send_flags(flags: i32) -> i32 { return flags | MSG_NOSIGNAL; }
#[target(os="macos")]
fun _vector_send_flags(flags: i32) -> i32 { return flags; }
#[target(os="windows")]
fun _vector_send_flags(flags: i32) -> i32 { return flags; }

fun _native_slices(
    slices: ptr<NetIoSlice>, count: i32, output: ptr<NativeIoSlice>
) -> i64 {
    if (count < 0 || count > NET_IOV_MAX || (slices == null && count > 0)) { return -22; }
    var i: i32 = 0;
    while (i < count) {
        var result: i64 = native_io_slice(slices[i].data, slices[i].length, output + i);
        if (result < 0) { return result; }
        i += 1;
    }
    return 0;
}

pub fun net_send_vectored(
    fd: i64, slices: ptr<NetIoSlice>, count: i32, flags: i32
) -> NetIoResult {
    if (!net_fd_valid(fd)) {
        return net_io_error(0, -22);
    }
    var native: array<NativeIoSlice, 32>;
    var prepared: i64 = _native_slices(slices, count, &native[0]);
    if (prepared < 0) { return net_io_error(0, prepared); }
    if (count == 0) { return net_io_ok(0); }
    var result: i64 = vector_send(fd, &native[0], count, _vector_send_flags(flags));
    if (result < 0) { return net_io_error(0, result); }
    return net_io_ok(result);
}

pub fun net_recv_vectored(
    fd: i64, slices: ptr<NetIoSlice>, count: i32, flags: i32, eof_on_zero: bool
) -> NetIoResult {
    if (!net_fd_valid(fd)) {
        return net_io_error(0, -22);
    }
    var native: array<NativeIoSlice, 32>;
    var prepared: i64 = _native_slices(slices, count, &native[0]);
    if (prepared < 0) { return net_io_error(0, prepared); }
    if (count == 0) { return net_io_ok(0); }
    if (eof_on_zero) {
        var i: i32 = 0;
        while (i < count && slices[i].length == 0) { i += 1; }
        if (i == count) { return net_io_ok(0); }
    }
    var result: i64 = vector_recv(fd, &native[0], count, flags);
    if (result < 0) { return net_io_error(0, result); }
    if (result == 0 && eof_on_zero) { return net_io_eof(0); }
    return net_io_ok(result);
}

// Receives exactly one datagram, including when the supplied capacity is zero.
pub fun net_recv_vectored_datagram(fd: i64, slices: ptr<NetIoSlice>, count: i32) -> NetDatagramResult {
    if (!net_fd_valid(fd)) {
        return net_datagram_error(-22);
    }
    var native: array<NativeIoSlice, 32>;
    var prepared: i64 = _native_slices(slices, count, &native[0]);
    if (prepared < 0) {
        return net_datagram_error(prepared);
    }
    var capacity: i64 = 0;
    var i: i32 = 0;
    while (i < count) {
        if (slices[i].length > 9223372036854775807 - capacity) {
            return net_datagram_error(-22);
        }
        capacity += slices[i].length;
        i += 1;
    }
    var native_count: i32 = count;
    var native_capacity: i64 = capacity;
    var discard: u8 = 0;
    if (capacity == 0) {
        // Some providers return immediately for zero native capacity. A
        // private byte consumes one message without touching caller storage.
        native_io_slice(&discard, 1, &native[0]);
        native_count = 1;
        native_capacity = 1;
    }
    var cut: bool = false;
    var original: i64 = -1;
    var stored: i64 = vector_recv_datagram(fd, &native[0], native_count, 0, native_capacity, &cut, &original);
    if (stored < 0) {
        return net_datagram_error(stored);
    }
    if (capacity == 0) {
        cut = cut || stored > 0;
        stored = 0;
    }
    if (original >= 0) {
        return NetDatagramResult { count: stored, truncated: cut, original_size_known: true, original_size: original, error: net_error_none() };
    }
    return NetDatagramResult { count: stored, truncated: cut, original_size_known: false, original_size: 0, error: net_error_none() };
}
