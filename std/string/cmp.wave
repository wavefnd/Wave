import("std::string::ascii")::{to_lower};

pub fun eq(a: str, b: str) -> bool {
    var i: i32 = 0;

    while (true) {
        var ca: u8 = a[i];
        var cb: u8 = b[i];

        if (ca != cb) {
            return false;
        }

        if (ca == 0) {
            return true;
        }

        i += 1;
    }

    return true;
}

// Compare NUL-terminated strings, folding only ASCII A-Z.
// Other bytes compare exactly; neither input is modified and nothing is allocated.
pub fun eq_ignore_ascii_case(a: str, b: str) -> bool {
    var i: i32 = 0;

    while (true) {
        var ca: u8 = a[i];
        var cb: u8 = b[i];

        if (to_lower(ca) != to_lower(cb)) {
            return false;
        }

        if (ca == 0) {
            return true;
        }

        i += 1;
    }

    return true;
}

pub fun cmp(a: str, b: str) -> i32 {
    var i: i32 = 0;

    while (true) {
        var ca: u8 = a[i];
        var cb: u8 = b[i];

        if (ca < cb) {
            return -1;
        }

        if (ca > cb) {
            return 1;
        }

        if (ca == 0) {
            return 0;
        }

        i += 1;
    }

    return 0;
}

pub fun starts_with(s: str, prefix: str) -> bool {
    var i: i32 = 0;

    while (prefix[i] != 0) {
        if (s[i] != prefix[i]) {
            return false;
        }

        i += 1;
    }

    return true;
}

pub fun ends_with(s: str, suffix: str) -> bool {
    var sl: i32 = 0;
    while (s[sl] != 0) {
        sl += 1;
    }

    var tl: i32 = 0;
    while (suffix[tl] != 0) {
        tl += 1;
    }

    if (tl > sl) {
        return false;
    }

    var i: i32 = 0;
    while (i < tl) {
        var idx: i32 = (sl - tl) + i;
        if (s[idx] != suffix[i]) {
            return false;
        }

        i += 1;
    }

    return true;
}
