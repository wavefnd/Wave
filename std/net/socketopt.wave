#[target(os="linux")]
pub fun net_set_reuseport_flag(fd: i64, enabled: i32) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    return _net_set_reuseport(fd, enabled);
}
#[target(os="macos")]
pub fun net_set_reuseport_flag(fd: i64, enabled: i32) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    return _net_set_reuseport(fd, enabled);
}
#[target(os="freebsd")]
pub fun net_set_reuseport_flag(fd: i64, enabled: i32) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    return _net_set_reuseport(fd, enabled);
}
#[target(os="windows")]
pub fun net_set_reuseport_flag(fd: i64, enabled: i32) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    return -95;
}

#[target(os="linux")]
fun _net_set_reuseport(fd: i64, enabled: i32) -> i64 {
    var value: i32 = 0;
    if (enabled != 0) { value = 1; }
    return setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, &value as ptr<i8>, 4);
}
#[target(os="macos")]
fun _net_set_reuseport(fd: i64, enabled: i32) -> i64 {
    var value: i32 = 0;
    if (enabled != 0) { value = 1; }
    return setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, &value as ptr<i8>, 4);
}
#[target(os="freebsd")]
fun _net_set_reuseport(fd: i64, enabled: i32) -> i64 {
    var value: i32 = 0;
    if (enabled != 0) { value = 1; }
    return setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, &value as ptr<i8>, 4);
}
