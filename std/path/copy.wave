import("std::path::core")::{
    path_is_sep,
    path_len,
    path_is_abs,
};
import("std::path::analyze")::{
    path_basename_start,
    path_basename_len,
    path_dirname_len,
    path_ext_start,
    path_has_ext,
};

// Join according to the selected target's path syntax, without consulting CWD.
pub fun path_join2(dst: ptr<u8>, dst_cap: i32, left: str, right: str) -> i32 {
    if (dst == null || dst_cap <= 0) { return -1; }
    var ll: i32 = path_len(left);
    var rl: i32 = path_len(right);
    var right_start: i32 = 0;
    var windows: bool = path_is_sep(92);
    var left_drive: bool = ll >= 2 && left[1] == 58
        && ((left[0] >= 65 && left[0] <= 90) || (left[0] >= 97 && left[0] <= 122));
    var right_drive: bool = windows && rl >= 2 && right[1] == 58
        && ((right[0] >= 65 && right[0] <= 90) || (right[0] >= 97 && right[0] <= 122));
    if (path_is_abs(right)) {
        ll = 0;
    } else if (right_drive) {
        if (left_drive && (left[0] | 32) == (right[0] | 32)) {
            right_start = 2;
            rl -= 2;
        } else {
            ll = 0;
        }
    } else if (windows && rl > 0 && path_is_sep(right[0])) {
        // Root-relative paths retain only the drive or complete UNC volume.
        if (left_drive) {
            ll = 2;
        } else if (ll >= 2 && path_is_sep(left[0]) && path_is_sep(left[1]) && path_is_abs(left)) {
            var end: i32 = 2;
            while (left[end] != 0 && !path_is_sep(left[end])) {
                end += 1;
            }
            end += 1;
            while (left[end] != 0 && !path_is_sep(left[end])) {
                end += 1;
            }
            ll = end;
        } else {
            ll = 0;
        }
    }
    var need_sep: i32 = 0;
    if (ll > 0 && rl > 0 && !path_is_sep(left[ll - 1]) && !path_is_sep(right[right_start])) {
        // C:child remains drive-relative; C:/child is a different path.
        if (!(windows && left_drive && ll == 2)) {
            need_sep = 1;
        }
    }
    if (ll >= dst_cap || rl >= dst_cap - ll) { return -1; }
    if (need_sep >= dst_cap - ll - rl) { return -1; }
    var total: i32 = ll + rl + need_sep;
    var k: i32 = 0;
    while (k < ll) {
        deref dst[k] = left[k];
        k += 1;
    }
    if (need_sep == 1) {
        deref dst[k] = 47;
        k += 1;
    }
    var i: i32 = 0;
    while (i < rl) {
        deref dst[k + i] = right[right_start + i];
        i += 1;
    }
    deref dst[total] = 0;
    return total;
}

pub fun path_basename_copy(dst: ptr<u8>, dst_cap: i32, path: str) -> i32 {
    if (dst == null || dst_cap <= 0) { return -1; }
    var start: i32 = path_basename_start(path);
    var n: i32 = path_basename_len(path);

    if (n >= dst_cap) {
        return -1;
    }

    var src_idx: i32 = start;
    var dst_idx: i32 = 0;
    while (dst_idx < n) {
        deref dst[dst_idx] = path[src_idx];
        src_idx += 1;
        dst_idx += 1;
    }

    deref dst[n] = 0;
    return n;
}

pub fun path_dirname_copy(dst: ptr<u8>, dst_cap: i32, path: str) -> i32 {
    if (dst == null || dst_cap <= 0) { return -1; }
    var n: i32 = path_dirname_len(path);
    var output_len: i32 = n;
    if (output_len == 0) {
        output_len = 1;
    }

    if (dst_cap <= output_len) {
        return -1;
    }

    if (n == 0) {
        deref dst[0] = 46;
        deref dst[1] = 0;
        return 1;
    }

    var i: i32 = 0;
    while (i < n) {
        deref dst[i] = path[i];
        i += 1;
    }

    deref dst[n] = 0;
    return n;
}
