import("std::net::error")::{NET_NATIVE_TIMEOUT, net_connect_pending};
// Cooperative async tasks. Futures are lazy and single-consumer handles.
// Complete or cancel outstanding work, then call shutdown to release the executor.
// Windows sockets remain usable across shutdown; their IOCP is released after
// the last associated socket is closed through std::net (on the executor thread).
import("std::mem::alloc")::{mem_alloc_zeroed, mem_free};
import("std::mem::layout")::{size_of};
import("std::process::core")::{proc_exit};
import("std::net::event")::{NetEventLoop, NetEvent, NetEventWaitResult, net_event_loop_create, net_event_loop_close, net_event_add, net_event_remove, net_event_wait};
import("std::net::error")::{NetError, NetResult};
import("std::time::clock")::{TimeSpec, time_now_monotonic};
import("std::time::sleep")::{time_sleep_ms};
#[target(os="windows")]
import("std::sys::windows::iocp")::{IocpCompletion, iocp_start_io, iocp_watch, iocp_cancel, iocp_wait, iocp_shutdown};

struct TaskSlot {
    id: i64; frame: ptr<u8>; size: i64; result: ptr<u8>; poll: ptr<u8>;
    state: i32; waiting: i64; yield_step: i32; next: ptr<TaskSlot>;
    kind: i32; fd: i64; flags: i32; deadline: i64; registered: bool;
    buffer: ptr<u8>; length: i64; writing: bool; terminal: i64;
    previous: ptr<TaskSlot>;
    hash_next: ptr<TaskSlot>;
    ready_next: ptr<TaskSlot>;
    ready_previous: ptr<TaskSlot>;
    queued: bool;
    dependents: ptr<TaskSlot>;
    dependency: ptr<TaskSlot>;
    dependent_next: ptr<TaskSlot>;
    dependent_previous: ptr<TaskSlot>;
    settle_next: ptr<TaskSlot>;
    settling: bool;
    event_next: ptr<TaskSlot>;
    event_previous: ptr<TaskSlot>;
    event_linked: bool;
}
// Only live handles appear in _head and the identity index. Reusable slots are
// kept separately so a past fan-out does not slow the next small workload.
static _head: ptr<TaskSlot> = null;
static _free_slots: ptr<TaskSlot> = null;
static _index: ptr<ptr<TaskSlot>> = null;
static _index_capacity: i64 = 0;
static _live_count: i64 = 0;
static _ready_head: ptr<TaskSlot> = null;
static _ready_tail: ptr<TaskSlot> = null;
static _ready_count: i64 = 0;
static _settle_head: ptr<TaskSlot> = null;
static _settle_tail: ptr<TaskSlot> = null;
static _event_slots: ptr<TaskSlot> = null;
static _next_id: i64 = 1;
static _driving: bool = false;
static _event_handle: i64 = -1;
static _event_backend: i32 = 0;
fun _now_ms() -> i64 {
    var ts: TimeSpec;
    if (time_now_monotonic(&ts) < 0) { proc_exit(73); }
    return ts.sec * 1000 + ts.nsec / 1000000;
}
// A descriptor owns one native watch. Logical waiters retain separate masks and deadlines.
struct WatchGroup {
    fd: i64; token: i64; flags: i32; active: bool; draining: bool; next: ptr<WatchGroup>;
}
static _watches: ptr<WatchGroup> = null;
fun _identity() -> i64 {
    if (_next_id <= 0 || _next_id == 9223372036854775807) { proc_exit(71); }
    var id: i64 = _next_id; _next_id += 1; return id;
}
fun _watch_for(fd: i64) -> ptr<WatchGroup> {
    var group: ptr<WatchGroup> = _watches;
    while (group != null) {
        if (group.fd == fd) {
            return group;
        }
        group = group.next;
    }
    return null;
}
fun _discard_watch(group: ptr<WatchGroup>) {
    var previous: ptr<WatchGroup> = null;
    var cursor: ptr<WatchGroup> = _watches;
    while (cursor != null) {
        if (cursor == group) {
            if (previous == null) {
                _watches = cursor.next;
            } else {
                previous.next = cursor.next;
            }
            __wave_async_free_slot(cursor);
            return;
        }
        previous = cursor;
        cursor = cursor.next;
    }
}
fun _store_event(slot: ptr<TaskSlot>, value: i32) {
    var output: ptr<i32> = slot.result as ptr<i32>;
    deref output = value; _complete(slot.id);
}
fun _refresh_watch(fd: i64) {
    if (fd < 0) { return; }
    var group: ptr<WatchGroup> = _watch_for(fd);
    var flags: i32 = 0;
    var slot: ptr<TaskSlot> = _event_slots;
    while (slot != null) {
        var next_event: ptr<TaskSlot> = slot.event_next;
        if (slot.state == 4 && slot.kind == 1 && slot.fd == fd) { flags = flags | slot.flags; }
        slot = next_event;
    }
    if (group == null) {
        // Closing a descriptor or cancelling its final lazy waiter needs no record.
        if (flags == 0) { return; }
        group = __wave_async_alloc<WatchGroup>();
        group.fd = fd;
        group.next = _watches;
        _watches = group;
    }
    if (group.draining) { return; }
    if (group.active && group.flags == flags) { return; }
    if (group.active) {
        group.draining = _watch_stop(group.token, fd);
        group.active = false;
        if (group.draining) { return; }
    }
    group.flags = flags;
    if (flags == 0) { _discard_watch(group); return; }
    group.token = _identity();
    var status: i64 = _watch_start(group.token, fd, flags);
    if (status >= 0) { group.active = true; return; }
    slot = _event_slots;
    while (slot != null) {
        var next_event: ptr<TaskSlot> = slot.event_next;
        if (slot.state == 4 && slot.kind == 1 && slot.fd == fd) { _store_event(slot, status as i32); }
        slot = next_event;
    }
    _discard_watch(group);
}
fun _deliver_watch(token: i64, value: i32) {
    var group: ptr<WatchGroup> = _watches;
    while (group != null) {
        if (group.token == token && (group.active || group.draining)) {
            if (group.draining) { group.draining = false; _refresh_watch(group.fd); return; }
            // IOCP has consumed its one-shot packet; epoll/kqueue detach here.
            group.draining = _watch_stop(group.token, group.fd);
            group.active = false;
            var slot: ptr<TaskSlot> = _event_slots;
            while (slot != null) {
                var next_event: ptr<TaskSlot> = slot.event_next;
                if (slot.state == 4 && slot.kind == 1 && slot.fd == group.fd) {
                    if (value < 0 || (value & (slot.flags | 4 | 8)) != 0) { _store_event(slot, value); }
                }
                slot = next_event;
            }
            _refresh_watch(group.fd); return;
        }
        group = group.next;
    }
}
fun _event_result(slot: ptr<TaskSlot>, value: i32) {
    _store_event(slot, value); _refresh_watch(slot.fd);
}
fun _unregister_portable(slot: ptr<TaskSlot>) { _refresh_watch(slot.fd); }
fun _watch_start_portable(token: i64, fd: i64, flags: i32) -> i64 {
    if (_event_handle < 0) {
        var created: NetResult<NetEventLoop> = net_event_loop_create(64);
        if (!created.ok) { return created.error.native_code; }
        _event_handle = created.value.handle; _event_backend = created.value.backend;
    }
    var status: NetError = net_event_add(NetEventLoop { handle: _event_handle, backend: _event_backend }, fd, token as u64, flags);
    if (status.kind != 0) { return status.native_code; }
    return 0;
}
fun _watch_stop_portable(fd: i64) -> bool {
    if (_event_handle >= 0) { net_event_remove(NetEventLoop { handle: _event_handle, backend: _event_backend }, fd); }
    return false;
}
fun _arm_portable(slot: ptr<TaskSlot>) { slot.state = 4; _link_event(slot); _refresh_watch(slot.fd); }
fun _park_portable(blocking: bool) -> bool {
    var deadline: i64 = -1;
    var registered: bool = false;
    var waiting: bool = false;
    var slot: ptr<TaskSlot> = _event_slots;
    while (slot != null) {
        var next_event: ptr<TaskSlot> = slot.event_next;
        if (slot.state == 4 && slot.kind == 1) {
            waiting = true;
            if (slot.fd >= 0) { registered = true; }
            if (slot.deadline >= 0 && (deadline < 0 || slot.deadline < deadline)) { deadline = slot.deadline; }
        }
        slot = next_event;
    }
    if (!waiting) { return false; }
    var timeout: i32 = -1;
    if (deadline >= 0) {
        var remaining: i64 = deadline - _now_ms();
        if (remaining < 0) { remaining = 0; }
        if (remaining > 2147483647) { remaining = 2147483647; }
        timeout = remaining as i32;
    }
    if (!blocking) { timeout = 0; }
    if (registered) {
        var events: array<NetEvent, 64>;
        var batch: NetEventWaitResult = net_event_wait(NetEventLoop { handle: _event_handle, backend: _event_backend }, &events[0], 64, timeout);
        if (batch.error.kind != 0 && batch.error.kind != 2) { proc_exit(73); }
        var i: i32 = 0;
        while (i < batch.count) {
            var event: NetEvent = events[i];
            var flags: i32 = 0;
            if (event.readable) { flags = flags | 1; }
            if (event.writable) { flags = flags | 2; }
            if (event.error) { flags = flags | 4; }
            if (event.hangup) { flags = flags | 8; }
            _deliver_watch(event.token as i64, flags);
            i += 1;
        }
    } else {
        if (timeout < 0) { return false; }
        time_sleep_ms(timeout as i64);
    }
    var now: i64 = _now_ms();
    slot = _event_slots;
    while (slot != null) {
        var next_event: ptr<TaskSlot> = slot.event_next;
        if (slot.state == 4 && slot.kind == 1 && slot.deadline >= 0 && slot.deadline <= now) {
            if (slot.fd < 0) { _event_result(slot, 0); }
            else { _event_result(slot, NET_NATIVE_TIMEOUT as i32); }
        }
        slot = next_event;
    }
    return true;
}

// Grow a power-of-two hash table at a load factor of at most one half.
// The index contains live identities only; stale handles never resolve to reuse.
fun _grow_index() {
    var capacity: i64 = 64;
    if (_index_capacity > 0) {
        if (_index_capacity > 576460752303423487) {
            proc_exit(71);
        }
        capacity = _index_capacity * 2;
    }
    var stride: i64 = size_of<ptr<TaskSlot>>() as i64;
    if (capacity > 9223372036854775807 / stride) {
        proc_exit(71);
    }
    var table: ptr<ptr<TaskSlot>> = _allocate(capacity * stride) as ptr<ptr<TaskSlot>>;
    var slot: ptr<TaskSlot> = _head;
    while (slot != null) {
        var bucket: i64 = slot.id & (capacity - 1);
        slot.hash_next = table[bucket];
        table[bucket] = slot;
        slot = slot.next;
    }
    if (_index != null) {
        mem_free(_index as ptr<u8>, _index_capacity * stride);
    }
    _index = table;
    _index_capacity = capacity;
}
fun _find(id: i64) -> ptr<TaskSlot> {
    if (id <= 0 || _index_capacity == 0) {
        proc_exit(70);
    }
    var slot: ptr<TaskSlot> = _index[id & (_index_capacity - 1)];
    while (slot != null) {
        if (slot.id == id) {
            return slot;
        }
        slot = slot.hash_next;
    }
    proc_exit(70);
}
fun _link_event(slot: ptr<TaskSlot>) {
    if (slot.event_linked) {
        return;
    }
    slot.event_linked = true;
    slot.event_next = _event_slots;
    slot.event_previous = null;
    if (_event_slots != null) {
        _event_slots.event_previous = slot;
    }
    _event_slots = slot;
}
fun _remove_event(slot: ptr<TaskSlot>) {
    if (!slot.event_linked) {
        return;
    }
    if (slot.event_previous == null) {
        _event_slots = slot.event_next;
    } else {
        slot.event_previous.event_next = slot.event_next;
    }
    if (slot.event_next != null) {
        slot.event_next.event_previous = slot.event_previous;
    }
    slot.event_next = null;
    slot.event_previous = null;
    slot.event_linked = false;
}
fun _schedule(slot: ptr<TaskSlot>) {
    slot.state = 2;
    if (slot.queued) {
        return;
    }
    slot.queued = true;
    slot.ready_previous = _ready_tail;
    slot.ready_next = null;
    if (_ready_tail == null) {
        _ready_head = slot;
    } else {
        _ready_tail.ready_next = slot;
    }
    _ready_tail = slot;
    _ready_count += 1;
}
fun _remove_ready(slot: ptr<TaskSlot>) {
    if (!slot.queued) {
        return;
    }
    if (slot.ready_previous == null) {
        _ready_head = slot.ready_next;
    } else {
        slot.ready_previous.ready_next = slot.ready_next;
    }
    if (slot.ready_next == null) {
        _ready_tail = slot.ready_previous;
    } else {
        slot.ready_next.ready_previous = slot.ready_previous;
    }
    slot.ready_next = null;
    slot.ready_previous = null;
    slot.queued = false;
    _ready_count -= 1;
}
fun _detach_dependency(slot: ptr<TaskSlot>) {
    var child: ptr<TaskSlot> = slot.dependency;
    if (child == null) {
        return;
    }
    if (slot.dependent_previous == null) {
        child.dependents = slot.dependent_next;
    } else {
        slot.dependent_previous.dependent_next = slot.dependent_next;
    }
    if (slot.dependent_next != null) {
        slot.dependent_next.dependent_previous = slot.dependent_previous;
    }
    slot.dependency = null;
    slot.dependent_next = null;
    slot.dependent_previous = null;
}
fun _attach_dependency(parent: ptr<TaskSlot>, child: ptr<TaskSlot>) {
    _detach_dependency(parent);
    parent.dependency = child;
    parent.dependent_next = child.dependents;
    if (child.dependents != null) {
        child.dependents.dependent_previous = parent;
    }
    child.dependents = parent;
}
fun _queue_settle(slot: ptr<TaskSlot>) {
    if (slot.settling) {
        return;
    }
    slot.settling = true;
    slot.settle_next = null;
    if (_settle_tail == null) {
        _settle_head = slot;
    } else {
        _settle_tail.settle_next = slot;
    }
    _settle_tail = slot;
}
fun _wake_dependents(id: i64) {
    var child: ptr<TaskSlot> = _find(id);
    while (child.dependents != null) {
        var slot: ptr<TaskSlot> = child.dependents;
        _detach_dependency(slot);
        if (slot.state == 7) {
            _queue_settle(slot);
        } else if (slot.state == 4) {
            _schedule(slot);
        }
    }
}
// These exported symbols form the private compiler/runtime boundary.
export(c, "__wave_task_alloc") fun _allocate(size: i64) -> ptr<u8> {
    var memory: ptr<u8> = mem_alloc_zeroed(size);
    if (memory == null) { proc_exit(71); }
    return memory;
}
export(c, "__wave_task_free") fun _free(memory: ptr<u8>, size: i64) { mem_free(memory, size); }
export(c, "__wave_task_new") fun _new(
    frame: ptr<u8>, size: i64, result: ptr<u8>, poll: ptr<u8>
) -> i64 {
    if (_index_capacity == 0 || _live_count >= _index_capacity / 2) {
        _grow_index();
    }
    var slot: ptr<TaskSlot> = _free_slots;
    if (slot == null) {
        slot = __wave_async_alloc<TaskSlot>();
    } else {
        _free_slots = slot.next;
    }
    slot.previous = null;
    slot.next = _head;
    if (_head != null) {
        _head.previous = slot;
    }
    _head = slot;
    slot.id = _identity();
    var bucket: i64 = slot.id & (_index_capacity - 1);
    slot.hash_next = _index[bucket];
    _index[bucket] = slot;
    _live_count += 1;
    slot.frame = frame;
    slot.size = size;
    slot.result = result;
    slot.poll = poll;
    slot.state = 1;
    slot.waiting = 0;
    slot.yield_step = 0;
    slot.kind = 0; slot.fd = -1; slot.flags = 0; slot.deadline = -1; slot.registered = false;
    slot.buffer = null; slot.length = 0; slot.writing = false; slot.terminal = 0;
    return slot.id;
}
export(c, "__wave_task_spawn") fun _spawn(id: i64) -> i64 {
    var slot: ptr<TaskSlot> = _find(id);
    if (slot.state == 1) {
        if (slot.kind == 1 || slot.kind == 2) { _arm(slot); }
        else if (slot.kind == 3) {
            slot.state = 4;
            _attach_dependency(slot, _find(slot.waiting));
            _cancel(slot.waiting);
            _settle_cancelled();
            _finish_cancel_waiter(slot);
        } else { _schedule(slot); }
    }
    if (slot.state == 0 || slot.state == 6 || slot.state == 7) { proc_exit(70); }
    return id;
}
export(c, "__wave_task_ready") fun _ready(id: i64) -> i32 {
    var slot: ptr<TaskSlot> = _find(id);
    if (slot.state == 0 || slot.state == 6 || slot.state == 7) { proc_exit(70); }
    if (slot.state == 5) { return 1; }
    return 0;
}
export(c, "__wave_task_wait") fun _wait(parent: i64, child: i64) {
    if (parent == child) { proc_exit(72); }
    var p: ptr<TaskSlot> = _find(parent);
    p.waiting = child;
    p.state = 4;
    _attach_dependency(p, _find(child));
    _spawn(child);
    if (_ready(child) == 1) { _detach_dependency(p); _schedule(p); }
}
export(c, "__wave_task_complete") fun _complete(id: i64) {
    var slot: ptr<TaskSlot> = _find(id);
    _remove_ready(slot);
    _remove_event(slot);
    _detach_dependency(slot);
    slot.state = 5;
    slot.waiting = 0;
    _wake_dependents(id);
}
export(c, "__wave_task_result") fun _result(id: i64) -> ptr<u8> {
    if (_ready(id) != 1) { proc_exit(70); }
    return _find(id).result;
}
export(c, "__wave_task_release") fun _release(id: i64) {
    var slot: ptr<TaskSlot> = _find(id);
    if (slot.state != 5 && slot.state != 6) {
        proc_exit(70);
    }
    _remove_event(slot);
    if (slot.frame != null) {
        mem_free(slot.frame, slot.size);
    }
    slot.frame = null;
    slot.result = null;
    slot.poll = null;
    _remove_ready(slot);
    _detach_dependency(slot);
    var bucket: i64 = id & (_index_capacity - 1);
    var cursor: ptr<TaskSlot> = _index[bucket];
    var previous: ptr<TaskSlot> = null;
    while (cursor != slot) {
        previous = cursor;
        cursor = cursor.hash_next;
    }
    if (previous == null) {
        _index[bucket] = slot.hash_next;
    } else {
        previous.hash_next = slot.hash_next;
    }
    if (slot.previous == null) {
        _head = slot.next;
    } else {
        slot.previous.next = slot.next;
    }
    if (slot.next != null) {
        slot.next.previous = slot.previous;
    }
    slot.state = 0;
    slot.id = 0;
    slot.previous = null;
    slot.hash_next = null;
    slot.next = _free_slots;
    _free_slots = slot;
    _live_count -= 1;
}
fun _finish_cancel_waiter(slot: ptr<TaskSlot>) {
    var child: ptr<TaskSlot> = _find(slot.waiting);
    if (child.state == 5 || child.state == 6) {
        _release(child.id);
        slot.waiting = 0;
        _complete(slot.id);
    }
}
fun _settle_cancelled() {
    while (_settle_head != null) {
        var slot: ptr<TaskSlot> = _settle_head;
        _settle_head = slot.settle_next;
        if (_settle_head == null) {
            _settle_tail = null;
        }
        slot.settle_next = null;
        slot.settling = false;
        if (slot.state == 7 && !slot.registered) {
            var ready: bool = slot.waiting == 0;
            if (!ready) {
                var child: ptr<TaskSlot> = _find(slot.waiting);
                ready = child.state == 5 || child.state == 6;
            }
            if (ready) {
                // Await owns its child until kernel cancellation acknowledges buffers.
                _remove_event(slot);
                _detach_dependency(slot);
                if (slot.waiting != 0) {
                    _release(slot.waiting);
                }
                if (slot.frame != null) {
                    mem_free(slot.frame, slot.size);
                    slot.frame = null;
                }
                slot.result = null;
                slot.poll = null;
                slot.state = 6;
                slot.waiting = 0;
                _wake_dependents(slot.id);
            }
        }
    }
}
export(c, "__wave_task_cancel") fun _cancel(id: i64) -> i32 {
    var first: ptr<TaskSlot> = _find(id);
    if (first.state == 5 || first.state == 6 || first.state == 7) { return 0; }
    var cursor: i64 = id;
    while (cursor > 0) {
        var slot: ptr<TaskSlot> = _find(cursor);
        if (slot.state == 0 || slot.state == 3) { proc_exit(70); }
        if (slot.state == 5 || slot.state == 6 || slot.state == 7) { break; }
        _remove_ready(slot);
        if (slot.waiting > 0 && slot.dependency == null) {
            _attach_dependency(slot, _find(slot.waiting));
        }
        slot.state = 7;
        if (slot.kind == 1) { _remove_event(slot); }
        _cancel_registration(slot);
        if (!slot.registered) { _remove_event(slot); }
        _queue_settle(slot);
        cursor = slot.waiting;
    }
    _settle_cancelled();
    return 1;
}
export(c, "__wave_task_cancel_join") fun _cancel_join(id: i64) -> i64 {
    _find(id);
    var waiter: i64 = _new(null, 0, null, null);
    var slot: ptr<TaskSlot> = _find(waiter);
    slot.kind = 3; slot.waiting = id;
    return waiter;
}
export(c, "__wave_task_drive") fun _drive(id: i64) {
    if (_driving) {
        proc_exit(72);
    }
    _driving = true;
    _spawn(id);
    while (_ready(id) == 0) {
        var progress: bool = false;
        // Process the current ready batch once; yields stay coalesced for the next
        // round, which still gives timers and native completion a fair turn.
        var remaining: i64 = _ready_count;
        while (remaining > 0 && _ready_head != null) {
            var slot: ptr<TaskSlot> = _ready_head;
            _remove_ready(slot);
            remaining -= 1;
            if (slot.state == 2) {
                progress = true;
                slot.state = 3;
                if (slot.poll == null) {
                    if (slot.kind == 3) {
                        slot.state = 4;
                        _finish_cancel_waiter(slot);
                    } else if (slot.yield_step == 0) {
                        slot.yield_step = 1;
                        _schedule(slot);
                    } else {
                        _complete(slot.id);
                    }
                } else {
                    __wave_async_invoke(slot.poll, slot.frame, slot.id);
                }
            }
        }
        if (!progress) { if (!_park(true)) { proc_exit(72); } } else { _park(false); }
    }
    _driving = false;
}
export(c, "__wave_task_yield") fun _yield() -> i64 {
    return _new(null, 0, null, null);
}
export(c, "__wave_task_shutdown") fun _shutdown() {
    if (_driving) {
        proc_exit(72);
    }
    _shutdown_native();
    var slot: ptr<TaskSlot> = _head;
    while (slot != null) {
        var next: ptr<TaskSlot> = slot.next;
        if (slot.frame != null) {
            mem_free(slot.frame, slot.size);
        }
        // Compiler supplies the exact target layout, including padding.
        __wave_async_free_slot(slot);
        slot = next;
    }
    _head = null;
    slot = _free_slots;
    while (slot != null) {
        var next: ptr<TaskSlot> = slot.next;
        __wave_async_free_slot(slot);
        slot = next;
    }
    _free_slots = null;
    if (_index != null) {
        mem_free(_index as ptr<u8>, _index_capacity * size_of<ptr<TaskSlot>>() as i64);
    }
    _index = null;
    _index_capacity = 0;
    _live_count = 0;
    _ready_head = null;
    _ready_tail = null;
    _ready_count = 0;
    _settle_head = null;
    _settle_tail = null;
    _event_slots = null;
    var group: ptr<WatchGroup> = _watches;
    while (group != null) {
        var next: ptr<WatchGroup> = group.next;
        __wave_async_free_slot(group);
        group = next;
    }
    _watches = null;
    if (_event_handle >= 0) { net_event_loop_close(NetEventLoop { handle: _event_handle, backend: _event_backend }); _event_handle = -1; }
}
pub fun block_on<T>(future: Future<T>) -> T { return __wave_async_block_on(future); }
pub fun spawn<T>(future: Future<T>) -> Future<T> { return __wave_async_spawn(future); }
pub async fun join<T>(future: Future<T>) -> T { return await future; }
pub fun cancel<T>(future: Future<T>) -> bool { return __wave_async_cancel(future); }
pub fun yield_now() -> Future<void> { return __wave_async_yield(); }
pub fun shutdown() { __wave_async_shutdown(); }

export(c, "__wave_task_interest") fun _interest(fd: i64, flags: i32, timeout_ms: i64) -> i64 {
    var memory: ptr<u8> = _allocate(4);
    var id: i64 = _new(memory, 4, memory, null);
    var slot: ptr<TaskSlot> = _find(id);
    slot.kind = 1; slot.fd = fd; slot.flags = flags;
    if (timeout_ms < -1 || (fd >= 0 && (flags < 1 || flags > 3)) || (fd < 0 && timeout_ms < 0)) { _event_result(slot, -22); return id; }
    if (timeout_ms >= 0) {
        var now: i64 = _now_ms();
        if (timeout_ms > 9223372036854775807 - now) { _event_result(slot, -22); return id; }
        slot.deadline = now + timeout_ms;
    }
    return id;
}
export(c, "__wave_task_close_fd") fun _close_fd(fd: i64) {
    var slot: ptr<TaskSlot> = _head;
    while (slot != null) {
        if (slot.fd == fd && slot.state != 0 && slot.state != 5 && slot.state != 6 && slot.state != 7) {
            if (slot.kind == 1) { _store_event(slot, -9); }
            else if (slot.kind == 2) { _close_io(slot); }
        }
        slot = slot.next;
    }
    _refresh_watch(fd);
}
// Ready bits: readable=1, writable=2, error=4, hangup=8; failures are negative.
// Waiters on the same descriptor share a native watch; cancellation affects only that waiter.
pub fun wait_fd(fd: i64, flags: i32, timeout_ms: i64) -> Future<i32> { return __wave_async_interest(fd, flags, timeout_ms); }
// Returns 0 on completion; negative durations and deadline overflow return -22.
pub fun sleep_ms(milliseconds: i64) -> Future<i32> { return __wave_async_sleep(milliseconds); }
pub fun closing_fd(fd: i64) { __wave_async_close_fd(fd); }

