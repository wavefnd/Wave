// Preserve every entry (including =C: drive entries) and both final NULs.
import("std::sys::windows::fs_errors")::{windows_fs_error};
extern(system, "GetEnvironmentStringsW") fun win_get_environment_strings() -> ptr<u16>;
extern(system, "FreeEnvironmentStringsW") fun win_free_environment_strings(block: ptr<u16>) -> i32;
extern(system, "GetLastError") fun env_last_error() -> u32;
extern(system, "WideCharToMultiByte") fun env_to_utf8(
    code_page: u32, flags: u32, source: ptr<u16>, units: i32,
    destination: ptr<u8>, capacity: i32, default_char: ptr<u8>, used_default: ptr<i32>
) -> i32;

fun release_environment(block: ptr<u16>, status: i64) -> i64 {
    if (win_free_environment_strings(block) == 0 && status >= 0) {
        return windows_fs_error(env_last_error());
    }
    return status;
}

pub fun env_read(buf: ptr<u8>, cap: i64) -> i64 {
    if (buf == null || cap <= 0) { return -22; }
    var block: ptr<u16> = win_get_environment_strings();
    if (block == null) { return windows_fs_error(env_last_error()); }

    var units: i64 = 0;
    while (units < 2147483646) {
        if (block[units] == 0 && block[units + 1] == 0) { break; }
        units += 1;
    }
    if (units >= 2147483646) { return release_environment(block, -75); }
    units += 2;
    // A positive explicit length converts embedded NULs too. Query the byte
    // count before writing, so insufficient capacity leaves the caller intact.
    var needed: i32 = env_to_utf8(65001, 128, block, units as i32, null, 0, null, null);
    if (needed == 0) { return release_environment(block, windows_fs_error(env_last_error())); }
    if (needed as i64 > cap) { return release_environment(block, -28); }
    var written: i32 = env_to_utf8(65001, 128, block, units as i32, buf, needed, null, null);
    if (written == 0) { return release_environment(block, windows_fs_error(env_last_error())); }
    return release_environment(block, written as i64);
}

// Ordinal native Unicode comparison, without locale-dependent UTF-8 folding.
extern(system, "MultiByteToWideChar") fun env_key_to_utf16(
    code_page: u32, flags: u32, source: ptr<u8>, bytes: i32,
    destination: ptr<u16>, capacity: i32
) -> i32;
extern(system, "CompareStringOrdinal") fun env_compare_keys(
    left: ptr<u16>, left_units: i32, right: ptr<u16>, right_units: i32,
    ignore_case: i32
) -> i32;
import("std::sys::memory")::{sys_alloc, sys_free};

pub fun env_key_matches(left: ptr<u8>, left_len: i64, right: ptr<u8>, right_len: i64) -> i32 {
    if (left_len <= 0 || right_len <= 0 || left_len > 2147483647 || right_len > 2147483647) {
        return -22;
    }
    var left_units: i32 = env_key_to_utf16(65001, 8, left, left_len as i32, null, 0);
    var right_units: i32 = env_key_to_utf16(65001, 8, right, right_len as i32, null, 0);
    if (left_units <= 0 || right_units <= 0) {
        return -22;
    }
    if (left_units != right_units) {
        return 0;
    }
    var left_size: i64 = (left_units as i64) * 2;
    var right_size: i64 = (right_units as i64) * 2;
    var left_raw: ptr<u8> = sys_alloc(left_size);
    if (left_raw == null) {
        return -12;
    }
    var right_raw: ptr<u8> = sys_alloc(right_size);
    if (right_raw == null) {
        sys_free(left_raw, left_size);
        return -12;
    }
    var left_wide: ptr<u16> = left_raw as ptr<u16>;
    var right_wide: ptr<u16> = right_raw as ptr<u16>;
    var converted_left: i32 = env_key_to_utf16(65001, 8, left, left_len as i32, left_wide, left_units);
    var converted_right: i32 = env_key_to_utf16(65001, 8, right, right_len as i32, right_wide, right_units);
    var equal: i32 = -22;
    if (converted_left == left_units && converted_right == right_units) {
        var compared: i32 = env_compare_keys(left_wide, left_units, right_wide, right_units, 1);
        if (compared != 0) {
            equal = (compared == 2) as i32;
        }
    }
    sys_free(right_raw, right_size);
    sys_free(left_raw, left_size);
    return equal;
}
