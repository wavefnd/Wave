// Shared socket ownership and I/O primitives. Public addresses are converted
// to native sockaddr values only for the duration of each OS call.

import("std::sys::socket")::{
    AF_INET, AF_INET6, SOCK_STREAM, SOCK_DGRAM, IPPROTO_TCP, IPPROTO_UDP,
    SHUT_RD, SHUT_WR, SHUT_RDWR, SOL_SOCKET, SO_REUSEADDR, MSG_NOSIGNAL,
    socket, bind, connect, accept, getsockname, getpeername,
    shutdown, close_socket, setsockopt,
    send, recv, sendto, recvfrom,
};
#[target(os="macos")]
import("std::sys::socket")::{SO_NOSIGPIPE};
import("std::sys::socket_addr")::{
    NATIVE_SOCKADDR_V4_LEN, NATIVE_SOCKADDR_V6_LEN,
    NativeSockAddrV4, NativeSockAddrV6,
    native_sockaddr_v4, native_sockaddr_v4_ip, native_sockaddr_v4_port,
    native_sockaddr_v6, native_sockaddr_v6_copy_ip, native_sockaddr_v6_port,
};
import("std::net::address")::{
    NetAddrV4, SocketAddrV4, SocketAddrV6,
    ipv6_unspecified, net_hton_u16, net_ntoh_u16,
    net_addr_to_socket_v4, socket_addr_to_net_v4,
};
import("std::net::error")::{
    NET_ERROR_OTHER, NetIoResult,
    net_error, net_io_ok, net_io_eof, net_io_error,
};

#[target(os="windows")]
pub fun net_fd_valid(fd: i64) -> bool { return fd >= 0; }
#[target(os="linux")]
pub fun net_fd_valid(fd: i64) -> bool {
    return fd >= 0 && fd <= 2147483647;
}
#[target(os="macos")]
pub fun net_fd_valid(fd: i64) -> bool {
    return fd >= 0 && fd <= 2147483647;
}
#[target(os="freebsd")]
pub fun net_fd_valid(fd: i64) -> bool {
    return fd >= 0 && fd <= 2147483647;
}

// MSG_PEEK is 0x2 on all supported socket providers.
const EXACT_RECV_PEEK: i32 = 2;

pub fun net_set_reuseaddr(fd: i64) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    var one: i32 = 1;
    return setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one as ptr<i8>, 4);
}

#[target(os="macos")]
fun _net_prepare_socket(fd: i64) -> i64 {
    var one: i32 = 1;
    return setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one as ptr<i8>, 4);
}

#[target(os="linux")]
fun _net_prepare_socket(fd: i64) -> i64 { return 0; }
#[target(os="windows")]
fun _net_prepare_socket(fd: i64) -> i64 { return 0; }
#[target(os="freebsd")]
fun _net_prepare_socket(fd: i64) -> i64 { return 0; }

fun _net_socket(domain: i32, ty: i32, protocol: i32) -> i64 {
    var fd: i64 = socket(domain, ty, protocol);
    if (fd < 0) { return fd; }
    var prepared: i64 = _net_prepare_socket(fd);
    if (prepared < 0) {
        close_socket(fd);
        return prepared;
    }
    return fd;
}

pub fun net_socket_tcp_v4() -> i64 { return _net_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP); }
pub fun net_socket_tcp_v6() -> i64 { return _net_socket(AF_INET6, SOCK_STREAM, IPPROTO_TCP); }
pub fun net_socket_udp_v4() -> i64 { return _net_socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP); }
pub fun net_socket_udp_v6() -> i64 { return _net_socket(AF_INET6, SOCK_DGRAM, IPPROTO_UDP); }

#[target(os="linux")]
fun _net_family(address: ptr<i8>) -> i32 {
    return (deref (address as ptr<u16>)) as i32;
}
#[target(os="windows")]
fun _net_family(address: ptr<i8>) -> i32 {
    return (deref (address as ptr<u16>)) as i32;
}
#[target(os="macos")]
fun _net_family(address: ptr<i8>) -> i32 {
    return (deref ((address + 1) as ptr<u8>)) as i32;
}
#[target(os="freebsd")]
fun _net_family(address: ptr<i8>) -> i32 {
    return (deref ((address + 1) as ptr<u8>)) as i32;
}

fun _net_address_valid(address: ptr<i8>, length: i32, expected: i32, family: i32) -> bool {
    if (length != expected) {
        return false;
    }
    return _net_family(address) == family;
}

fun _net_native_v4(addr: NetAddrV4) -> NativeSockAddrV4 {
    return native_sockaddr_v4(addr.ip, addr.port);
}

fun _net_from_native_v4(addr: NativeSockAddrV4) -> NetAddrV4 {
    return NetAddrV4 {
        ip: native_sockaddr_v4_ip(addr),
        port: native_sockaddr_v4_port(addr)
    };
}

pub fun net_decode_native_v4(address: ptr<i8>) -> SocketAddrV4 {
    var typed: ptr<NativeSockAddrV4> = address as ptr<NativeSockAddrV4>;
    return net_addr_to_socket_v4(_net_from_native_v4(deref typed));
}

pub fun net_bind_v4(fd: i64, addr: NetAddrV4) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    var native: NativeSockAddrV4 = _net_native_v4(addr);
    return bind(fd, &native as ptr<i8>, NATIVE_SOCKADDR_V4_LEN);
}

pub fun net_bind_socket_v4(fd: i64, addr: SocketAddrV4) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    return net_bind_v4(fd, socket_addr_to_net_v4(addr));
}

pub fun net_connect_v4(fd: i64, addr: NetAddrV4) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    var native: NativeSockAddrV4 = _net_native_v4(addr);
    return connect(fd, &native as ptr<i8>, NATIVE_SOCKADDR_V4_LEN);
}

pub fun net_connect_socket_v4(fd: i64, addr: SocketAddrV4) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    return net_connect_v4(fd, socket_addr_to_net_v4(addr));
}

pub fun net_accept_v4(fd: i64, out_addr: ptr<NetAddrV4>) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    var native: NativeSockAddrV4;
    var length: i32 = NATIVE_SOCKADDR_V4_LEN;
    var accepted: i64 = accept(fd, &native as ptr<i8>, &length);
    if (accepted >= 0 && out_addr != null) {
        if (!_net_address_valid(&native as ptr<i8>, length, NATIVE_SOCKADDR_V4_LEN, AF_INET)) {
            close_socket(accepted); return -22;
        }
        deref out_addr = _net_from_native_v4(native);
    }
    return accepted;
}

pub fun net_accept_socket_v4(fd: i64, out_addr: ptr<SocketAddrV4>) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (out_addr == null) {
        return net_accept_v4(fd, null);
    }
    var compat: NetAddrV4;
    var accepted: i64 = net_accept_v4(fd, &compat);
    if (accepted >= 0 && out_addr != null) {
        deref out_addr = net_addr_to_socket_v4(compat);
    }
    return accepted;
}

fun _net_native_v6(addr: SocketAddrV6) -> NativeSockAddrV6 {
    return native_sockaddr_v6(
        &addr.ip.octets[0], net_hton_u16(addr.port), addr.flowinfo, addr.scope_id
    );
}

fun _net_from_native_v6(native: NativeSockAddrV6) -> SocketAddrV6 {
    var addr: SocketAddrV6;
    addr.ip = ipv6_unspecified();
    native_sockaddr_v6_copy_ip(native, &addr.ip.octets[0]);
    addr.port = net_ntoh_u16(native_sockaddr_v6_port(native));
    addr.flowinfo = native.flowinfo;
    addr.scope_id = native.scope_id;
    return addr;
}

pub fun net_decode_native_v6(address: ptr<i8>) -> SocketAddrV6 {
    var typed: ptr<NativeSockAddrV6> = address as ptr<NativeSockAddrV6>;
    return _net_from_native_v6(deref typed);
}

pub fun net_bind_v6(fd: i64, addr: SocketAddrV6) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    var native: NativeSockAddrV6 = _net_native_v6(addr);
    return bind(fd, &native as ptr<i8>, NATIVE_SOCKADDR_V6_LEN);
}

pub fun net_connect_v6(fd: i64, addr: SocketAddrV6) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    var native: NativeSockAddrV6 = _net_native_v6(addr);
    return connect(fd, &native as ptr<i8>, NATIVE_SOCKADDR_V6_LEN);
}

pub fun net_accept_v6(fd: i64, out_addr: ptr<SocketAddrV6>) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    var native: NativeSockAddrV6;
    var length: i32 = NATIVE_SOCKADDR_V6_LEN;
    var accepted: i64 = accept(fd, &native as ptr<i8>, &length);
    if (accepted >= 0 && out_addr != null) {
        if (!_net_address_valid(&native as ptr<i8>, length, NATIVE_SOCKADDR_V6_LEN, AF_INET6)) {
            close_socket(accepted); return -22;
        }
        deref out_addr = _net_from_native_v6(native);
    }
    return accepted;
}

pub fun net_local_addr_v4(fd: i64, out_addr: ptr<SocketAddrV4>) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (out_addr == null) { return -22; }
    var native: NativeSockAddrV4;
    var length: i32 = NATIVE_SOCKADDR_V4_LEN;
    var result: i64 = getsockname(fd, &native as ptr<i8>, &length);
    if (result >= 0) {
        if (!_net_address_valid(&native as ptr<i8>, length, NATIVE_SOCKADDR_V4_LEN, AF_INET)) {
            return -22;
        }
        deref out_addr = net_addr_to_socket_v4(_net_from_native_v4(native));
    }
    return result;
}

pub fun net_peer_addr_v4(fd: i64, out_addr: ptr<SocketAddrV4>) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (out_addr == null) { return -22; }
    var native: NativeSockAddrV4;
    var length: i32 = NATIVE_SOCKADDR_V4_LEN;
    var result: i64 = getpeername(fd, &native as ptr<i8>, &length);
    if (result >= 0) {
        if (!_net_address_valid(&native as ptr<i8>, length, NATIVE_SOCKADDR_V4_LEN, AF_INET)) {
            return -22;
        }
        deref out_addr = net_addr_to_socket_v4(_net_from_native_v4(native));
    }
    return result;
}

pub fun net_local_addr_v6(fd: i64, out_addr: ptr<SocketAddrV6>) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (out_addr == null) { return -22; }
    var native: NativeSockAddrV6;
    var length: i32 = NATIVE_SOCKADDR_V6_LEN;
    var result: i64 = getsockname(fd, &native as ptr<i8>, &length);
    if (result >= 0) {
        if (!_net_address_valid(&native as ptr<i8>, length, NATIVE_SOCKADDR_V6_LEN, AF_INET6)) {
            return -22;
        }
        deref out_addr = _net_from_native_v6(native);
    }
    return result;
}

pub fun net_peer_addr_v6(fd: i64, out_addr: ptr<SocketAddrV6>) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (out_addr == null) { return -22; }
    var native: NativeSockAddrV6;
    var length: i32 = NATIVE_SOCKADDR_V6_LEN;
    var result: i64 = getpeername(fd, &native as ptr<i8>, &length);
    if (result >= 0) {
        if (!_net_address_valid(&native as ptr<i8>, length, NATIVE_SOCKADDR_V6_LEN, AF_INET6)) {
            return -22;
        }
        deref out_addr = _net_from_native_v6(native);
    }
    return result;
}

#[target(os="linux")]
fun _net_send_flags(flags: i32) -> i32 { return flags | MSG_NOSIGNAL; }
#[target(os="freebsd")]
fun _net_send_flags(flags: i32) -> i32 { return flags | MSG_NOSIGNAL; }
#[target(os="macos")]
fun _net_send_flags(flags: i32) -> i32 { return flags; }
#[target(os="windows")]
fun _net_send_flags(flags: i32) -> i32 { return flags; }

pub fun net_send_all(fd: i64, buf: ptr<u8>, len: i64, flags: i32) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (len < 0 || (buf == null && len > 0)) { return -22; }
    if (len == 0) { return 0; }

    var total: i64 = 0;
    while (total < len) {
        var count: i64 = send(fd, buf + total, len - total, _net_send_flags(flags));
        if (count == -4 || count == -10004) { continue; }
        if (count <= 0) {
            if (total == 0) { return count; }
            return total;
        }
        total += count;
    }
    return total;
}

// Unlike the legacy integer helper, this form preserves both partial progress
// and the terminal socket error.
pub fun net_send_all_io(fd: i64, buf: ptr<u8>, len: i64, flags: i32) -> NetIoResult {
    if (!net_fd_valid(fd)) {
        return net_io_error(0, -22);
    }
    if (len < 0 || (buf == null && len > 0)) { return net_io_error(0, -22); }
    if (len == 0) { return net_io_ok(0); }

    var total: i64 = 0;
    while (total < len) {
        var count: i64 = send(fd, buf + total, len - total, _net_send_flags(flags));
        if (count == -4 || count == -10004) { continue; }
        if (count < 0) { return net_io_error(total, count); }
        if (count == 0) {
            return NetIoResult {
                count: total,
                eof: false,
                error: net_error(NET_ERROR_OTHER, 0)
            };
        }
        total += count;
    }
    return net_io_ok(total);
}

pub fun net_send_once(fd: i64, buf: ptr<u8>, len: i64, flags: i32) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (len < 0 || (buf == null && len > 0)) { return -22; }
    var empty: u8 = 0;
    var native_buf: ptr<u8> = buf;
    if (native_buf == null) { native_buf = &empty; }
    return send(fd, native_buf, len, _net_send_flags(flags));
}

pub fun net_recv_once(fd: i64, buf: ptr<u8>, len: i64, flags: i32) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (len < 0 || (buf == null && len > 0)) { return -22; }
    var empty: u8 = 0;
    var native_buf: ptr<u8> = buf;
    if (native_buf == null) { native_buf = &empty; }
    return recv(fd, native_buf, len, flags);
}

pub fun net_recv_exact(fd: i64, buf: ptr<u8>, len: i64, flags: i32) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if ((flags & EXACT_RECV_PEEK) != 0) {
        return -22;
    }
    if (len < 0 || (buf == null && len > 0)) { return -22; }
    if (len == 0) { return 0; }

    var total: i64 = 0;
    while (total < len) {
        var count: i64 = recv(fd, buf + total, len - total, flags);
        if (count == -4 || count == -10004) { continue; }
        if (count <= 0) {
            if (total == 0) { return count; }
            return total;
        }
        total += count;
    }
    return total;
}

// EOF is distinct from an error and retains the number of bytes received
// before the peer closed its write side.
pub fun net_recv_exact_io(fd: i64, buf: ptr<u8>, len: i64, flags: i32) -> NetIoResult {
    if (!net_fd_valid(fd)) {
        return net_io_error(0, -22);
    }
    if ((flags & EXACT_RECV_PEEK) != 0) {
        return net_io_error(0, -22);
    }
    if (len < 0 || (buf == null && len > 0)) { return net_io_error(0, -22); }
    if (len == 0) { return net_io_ok(0); }

    var total: i64 = 0;
    while (total < len) {
        var count: i64 = recv(fd, buf + total, len - total, flags);
        if (count == -4 || count == -10004) { continue; }
        if (count < 0) { return net_io_error(total, count); }
        if (count == 0) { return net_io_eof(total); }
        total += count;
    }
    return net_io_ok(total);
}

pub fun net_sendto_v4(
    fd: i64, addr: NetAddrV4, buf: ptr<u8>, len: i64, flags: i32
) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (len < 0 || (buf == null && len > 0)) { return -22; }
    var native: NativeSockAddrV4 = _net_native_v4(addr);
    var empty: u8 = 0;
    var native_buf: ptr<u8> = buf;
    if (native_buf == null) { native_buf = &empty; }
    return sendto(
        fd, native_buf, len, _net_send_flags(flags),
        &native as ptr<i8>, NATIVE_SOCKADDR_V4_LEN
    );
}

pub fun net_recvfrom_v4(
    fd: i64, buf: ptr<u8>, len: i64, flags: i32, out_addr: ptr<NetAddrV4>
) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (len < 0 || (buf == null && len > 0)) { return -22; }
    var native: NativeSockAddrV4;
    var length: i32 = NATIVE_SOCKADDR_V4_LEN;
    var empty: u8 = 0;
    var native_buf: ptr<u8> = buf;
    if (native_buf == null) { native_buf = &empty; }
    var count: i64 = recvfrom(fd, native_buf, len, flags, &native as ptr<i8>, &length);
    if (count >= 0 && out_addr != null) {
        if (!_net_address_valid(&native as ptr<i8>, length, NATIVE_SOCKADDR_V4_LEN, AF_INET)) {
            return -22;
        }
        deref out_addr = _net_from_native_v4(native);
    }
    return count;
}

pub fun net_sendto_v6(
    fd: i64, addr: SocketAddrV6, buf: ptr<u8>, len: i64, flags: i32
) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (len < 0 || (buf == null && len > 0)) { return -22; }
    var native: NativeSockAddrV6 = _net_native_v6(addr);
    var empty: u8 = 0;
    var native_buf: ptr<u8> = buf;
    if (native_buf == null) { native_buf = &empty; }
    return sendto(
        fd, native_buf, len, _net_send_flags(flags),
        &native as ptr<i8>, NATIVE_SOCKADDR_V6_LEN
    );
}

pub fun net_recvfrom_v6(
    fd: i64, buf: ptr<u8>, len: i64, flags: i32, out_addr: ptr<SocketAddrV6>
) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (len < 0 || (buf == null && len > 0)) { return -22; }
    var native: NativeSockAddrV6;
    var length: i32 = NATIVE_SOCKADDR_V6_LEN;
    var empty: u8 = 0;
    var native_buf: ptr<u8> = buf;
    if (native_buf == null) { native_buf = &empty; }
    var count: i64 = recvfrom(fd, native_buf, len, flags, &native as ptr<i8>, &length);
    if (count >= 0 && out_addr != null) {
        if (!_net_address_valid(&native as ptr<i8>, length, NATIVE_SOCKADDR_V6_LEN, AF_INET6)) {
            return -22;
        }
        deref out_addr = _net_from_native_v6(native);
    }
    return count;
}

pub fun net_close(fd: i64) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    return close_socket(fd);
}

pub fun net_shutdown(fd: i64, how: i32) -> i64 {
    if (!net_fd_valid(fd)) {
        return -22;
    }
    if (how != SHUT_RD && how != SHUT_WR && how != SHUT_RDWR) { return -22; }
    return shutdown(fd, how);
}

pub fun net_shutdown_close(fd: i64) {
    if (!net_fd_valid(fd)) {
        return;
    }
    shutdown(fd, SHUT_RDWR);
    close_socket(fd);
}
