import("std::mem::consts")::{MEM_ERR_INVALID, MEM_ERR_NO_SPACE};

// Returns the byte length of a null-terminated Wave string.
pub fun mem_len_cstr(s: str) -> i64 {
    var i: i64 = 0;

    while (s[i] != 0) {
        i += 1;
    }

    return i;
}

// Scans at most max_len bytes. A missing terminator returns MEM_ERR_NO_SPACE.
pub fun mem_len_cstr_n(s: str, max_len: i64) -> i64 {
    if (max_len < 0) {
        return MEM_ERR_INVALID;
    }

    var i: i64 = 0;
    while (i < max_len) {
        if (s[i] == 0) {
            return i;
        }
        i += 1;
    }

    return MEM_ERR_NO_SPACE;
}

// Unbounded raw copy. Prefer mem_copy_cstr_n when the destination has a known
// capacity.
pub fun mem_copy_cstr(dst: ptr<u8>, s: str) -> i64 {
    if (dst == null) {
        return MEM_ERR_INVALID;
    }

    var i: i64 = 0;

    while (s[i] != 0) {
        deref dst[i] = s[i];
        i += 1;
    }

    deref dst[i] = 0;
    return i;
}

// Partial overlap of the bounded read/write regions is INVALID before writes.
// Exact alias is allowed. Success writes NUL; truncation writes the bounded
// prefix plus NUL and returns NO_SPACE, including when dst is the source.
pub fun mem_copy_cstr_n(dst: ptr<u8>, dst_cap: i64, s: str) -> i64 {
    if (dst == null || dst_cap <= 0) {
        return MEM_ERR_INVALID;
    }

    // Determine the bounded read/write ranges before changing either region.
    var count: i64 = 0;
    var max_copy: i64 = dst_cap - 1;
    while (count < max_copy && s[count] != 0) {
        count += 1;
    }
    var truncated: bool = s[count] != 0;
    var source: u64 = s as u64;
    var destination: u64 = dst as u64;
    var width: u64 = (count as u64) + 1;
    var maximum: u64 = (-1 as usz) as u64;
    if (width - 1 > maximum - source || width - 1 > maximum - destination) {
        return MEM_ERR_INVALID;
    }
    if (source != destination) {
        if ((source < destination && destination - source < width)
            || (destination < source && source - destination < width)) {
                return MEM_ERR_INVALID;
            }
    }
    var i: i64 = 0;
    while (i < count) {
        deref dst[i] = s[i];
        i += 1;
    }
    deref dst[count] = 0;
    if (truncated) {
        return MEM_ERR_NO_SPACE;
    }
    return count;
}

pub fun mem_eq_cstr(a: str, b: str) -> bool {
    var i: i64 = 0;
    while (true) {
        if (a[i] != b[i]) {
            return false;
        }
        if (a[i] == 0) {
            return true;
        }
        i += 1;
    }

    return true;
}

pub fun mem_starts_with_cstr(s: str, prefix: str) -> bool {
    var i: i64 = 0;
    while (prefix[i] != 0) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

pub fun mem_find_cstr_char(s: str, c: u8) -> i64 {
    var i: i64 = 0;
    while (s[i] != 0) {
        if (s[i] == c) {
            return i;
        }
        i += 1;
    }
    return -1;
}
