    }
    var bits: u64 = 0;
    var status: i32 = bytes_read_be_u64(src, offset, &bits);
    if (status != BYTES_OK) {
        return status;
    }
    deref out_value = float_from_bits_f64(bits);
    return BYTES_OK;
}

