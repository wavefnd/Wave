const FORWARD: i32 = BASE * 3 + 1;
const BASE: i32 = 7;
const CAST: i32 = (300 as u8) as i32;
const WRAP: u8 = (255 as u8) + (2 as u8);
const NEG: i32 = -7 / 3;
const REM: i32 = -7 % 3;
const BITS: u64 = ((1 as u64) << 40) | 13;
const FLOAT: f32 = ((16777216 as f32) + (1 as f32)) - (16777216 as f32);
const LESS: bool = 2.5 < 3.0;
const UNEQUAL: bool = (0.0 / 0.0) != 1.0;
const DEAD: bool = false && (1 / 0 == 1);
const DEAD_SHIFT: bool = true || (1 << 32 == 0);
const DEAD_CAST: bool = true || (((1e300 as f64) as i32) == 0);
const WIDE: u1024 = ((1 as u1024) << 1000) + 17;
const WIDE_NEG: i1024 = -(((1 as i1024) << 999) + 7);
const WIDE_QUOT: u1024 = WIDE / (3 as u1024);
const ARRAY: array<i32, 2> = [FORWARD, CAST];
struct Pair { x: i32; y: bool; }
const PAIR: Pair = Pair { x: BASE + 1, y: LESS && !DEAD };
static VALUE: i32 = FORWARD + CAST;
const ROUNDED: f32 = 1152921573326323713 as f32;
fun main() -> i32 {
    var literal: f32 = 1152921573326323713 as f32;
    var integer: u64 = 1152921573326323713;
    if (ROUNDED != literal || literal != (integer as f32)) { return 7; }
    var base: i32 = 7;
    var cast: i32 = 300;
    var a: u8 = 255;
    var two: u8 = 2;
    var neg: i32 = -7;
    var three: i32 = 3;
    var one: u64 = 1;
    var float: f32 = 16777216.0;
    var wide: u1024 = ((1 as u1024) << 1000) + 17;
    var wide_three: u1024 = 3;
    if (FORWARD != base * 3 + 1 || CAST != ((cast as u8) as i32)) { return 1; }
    if (WRAP != a + two || NEG != neg / three || REM != neg % three) { return 2; }
    if (BITS != ((one << 40) | 13) || FLOAT != ((float + (1 as f32)) - float)) { return 3; }
    if (!LESS || !UNEQUAL || DEAD || !DEAD_SHIFT || !DEAD_CAST) { return 4; }
    if (WIDE != wide || WIDE_QUOT != wide / wide_three || WIDE_NEG != -(((1 as i1024) << 999) + 7)) { return 5; }
    if (ARRAY[0] != 22 || ARRAY[1] != 44 || PAIR.x != 8 || !PAIR.y || VALUE != 66) { return 6; }
    return 0;
}
