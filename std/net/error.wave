// Portable network errors retain the native errno or Winsock code so protocol
// libraries can make a broad decision without losing platform diagnostics.

pub const NET_ERROR_NONE: i32 = 0;
pub const NET_ERROR_INVALID: i32 = 1;
pub const NET_ERROR_INTERRUPTED: i32 = 2;
pub const NET_ERROR_WOULD_BLOCK: i32 = 3;
pub const NET_ERROR_TIMED_OUT: i32 = 4;
pub const NET_ERROR_REFUSED: i32 = 5;
pub const NET_ERROR_RESET: i32 = 6;
pub const NET_ERROR_ADDRESS_IN_USE: i32 = 7;
pub const NET_ERROR_NOT_CONNECTED: i32 = 8;
pub const NET_ERROR_UNSUPPORTED: i32 = 9;
pub const NET_ERROR_EOF: i32 = 10;
pub const NET_ERROR_RESOLUTION: i32 = 11;
pub const NET_ERROR_OTHER: i32 = 12;

pub struct NetError {
    kind: i32;
    native_code: i64;
}

pub struct NetResult<T> {
    ok: bool;
    value: T;
    error: NetError;
}

pub struct NetIoResult {
    count: i64;
    eof: bool;
    error: NetError;
}

pub fun net_error_none() -> NetError {
    return NetError { kind: NET_ERROR_NONE, native_code: 0 };
}

pub fun net_error(kind: i32, native_code: i64) -> NetError {
    return NetError { kind: kind, native_code: native_code };
}

pub fun net_error_from_native(native_code: i64) -> NetError {
    if (native_code >= 0) {
        return net_error_none();
    }

    return net_error(classify_native_error(native_code), native_code);
}

// Compare negative codes directly: negating i64::MIN would overflow. These are
// target errno tables, not a union of numbers that happen to mean the same thing.

#[target(os="linux")]
fun classify_native_error(code: i64) -> i32 {
    if (code == -22) { return NET_ERROR_INVALID; }
    if (code == -4) { return NET_ERROR_INTERRUPTED; }
    if (code == -11) { return NET_ERROR_WOULD_BLOCK; }
    if (code == -110) { return NET_ERROR_TIMED_OUT; }
    if (code == -111) { return NET_ERROR_REFUSED; }
    if (code == -104) { return NET_ERROR_RESET; }
    if (code == -98) { return NET_ERROR_ADDRESS_IN_USE; }
    if (code == -107) { return NET_ERROR_NOT_CONNECTED; }
    if (code == -38 || code == -95) { return NET_ERROR_UNSUPPORTED; }
    return NET_ERROR_OTHER;
}

#[target(os="macos")]
fun classify_native_error(code: i64) -> i32 {
    if (code == -22) { return NET_ERROR_INVALID; }
    if (code == -4) { return NET_ERROR_INTERRUPTED; }
    if (code == -35) { return NET_ERROR_WOULD_BLOCK; }
    if (code == -60) { return NET_ERROR_TIMED_OUT; }
    if (code == -61) { return NET_ERROR_REFUSED; }
    if (code == -54) { return NET_ERROR_RESET; }
    if (code == -48) { return NET_ERROR_ADDRESS_IN_USE; }
    if (code == -57) { return NET_ERROR_NOT_CONNECTED; }
    if (code == -45 || code == -78 || code == -102) { return NET_ERROR_UNSUPPORTED; }
    return NET_ERROR_OTHER;
}

#[target(os="freebsd")]
fun classify_native_error(code: i64) -> i32 {
    if (code == -22) { return NET_ERROR_INVALID; }
    if (code == -4) { return NET_ERROR_INTERRUPTED; }
    if (code == -35) { return NET_ERROR_WOULD_BLOCK; }
    if (code == -60) { return NET_ERROR_TIMED_OUT; }
    if (code == -61) { return NET_ERROR_REFUSED; }
    if (code == -54) { return NET_ERROR_RESET; }
    if (code == -48) { return NET_ERROR_ADDRESS_IN_USE; }
    if (code == -57) { return NET_ERROR_NOT_CONNECTED; }
    if (code == -45 || code == -78) { return NET_ERROR_UNSUPPORTED; }
    return NET_ERROR_OTHER;
}

#[target(os="windows")]
fun classify_native_error(code: i64) -> i32 {
    // -22/-95 are explicit Wave validation/unsupported results, not Winsock aliases.
    if (code == -22 || code == -10022) { return NET_ERROR_INVALID; }
    if (code == -10004) { return NET_ERROR_INTERRUPTED; }
    if (code == -10035) { return NET_ERROR_WOULD_BLOCK; }
    if (code == -10060) { return NET_ERROR_TIMED_OUT; }
    if (code == -10061) { return NET_ERROR_REFUSED; }
    if (code == -10054) { return NET_ERROR_RESET; }
    if (code == -10048) { return NET_ERROR_ADDRESS_IN_USE; }
    if (code == -10057) { return NET_ERROR_NOT_CONNECTED; }
    if (code == -95 || code == -10043 || code == -10044
        || code == -10045 || code == -10047) { return NET_ERROR_UNSUPPORTED; }
    return NET_ERROR_OTHER;
}

#[target(os="none")]
fun classify_native_error(code: i64) -> i32 {
    if (code == -110) {
        return NET_ERROR_TIMED_OUT;
    }
    // No socket provider on these targets; only Wave-generated errors apply.
    if (code == -22) { return NET_ERROR_INVALID; }
    if (code == -95) { return NET_ERROR_UNSUPPORTED; }
    return NET_ERROR_OTHER;
}

#[target(os="unknown")]
fun classify_native_error(code: i64) -> i32 {
    if (code == -110) {
        return NET_ERROR_TIMED_OUT;
    }
    // Bare WebAssembly has no native socket errno namespace.
    if (code == -22) { return NET_ERROR_INVALID; }
    if (code == -95) { return NET_ERROR_UNSUPPORTED; }
    return NET_ERROR_OTHER;
}

#[target(os="wasi")]
fun classify_native_error(code: i64) -> i32 {
    if (code == -73) {
        return NET_ERROR_TIMED_OUT;
    }
    // No socket provider on these targets; only Wave-generated errors apply.
    if (code == -22) { return NET_ERROR_INVALID; }
    if (code == -95) { return NET_ERROR_UNSUPPORTED; }
    return NET_ERROR_OTHER;
}

pub fun net_result_ok<T>(value: T) -> NetResult<T> {
    return NetResult<T> {
        ok: true,
        value: value,
        error: net_error_none()
    };
}

pub fun net_result_err<T>(fallback: T, error: NetError) -> NetResult<T> {
    return NetResult<T> {
        ok: false,
        value: fallback,
        error: error
    };
}

pub fun net_io_from_native(value: i64) -> NetIoResult {
    if (value > 0) {
        return NetIoResult {
            count: value,
            eof: false,
            error: net_error_none()
        };
    }

    if (value == 0) {
        return NetIoResult {
            count: 0,
            eof: true,
            error: net_error(NET_ERROR_EOF, 0)
        };
    }

    return NetIoResult {
        count: 0,
        eof: false,
        error: net_error_from_native(value)
    };
}

pub fun net_io_ok(count: i64) -> NetIoResult {
    return NetIoResult { count: count, eof: false, error: net_error_none() };
}

pub fun net_io_eof(count: i64) -> NetIoResult {
    return NetIoResult {
        count: count,
        eof: true,
        error: net_error(NET_ERROR_EOF, 0)
    };
}

pub fun net_io_error(count: i64, native_code: i64) -> NetIoResult {
    return NetIoResult {
        count: count,
        eof: false,
        error: net_error_from_native(native_code)
    };
}

#[target(os="linux")]
pub const NET_NATIVE_TIMEOUT: i64 = -110;
#[target(os="linux")]
pub fun net_connect_pending(code: i64) -> bool {
    return code == -115 || code == -114;
}
#[target(os="macos")]
pub const NET_NATIVE_TIMEOUT: i64 = -60;
#[target(os="macos")]
pub fun net_connect_pending(code: i64) -> bool {
    return code == -36 || code == -37 || code == -35;
}
#[target(os="freebsd")]
pub const NET_NATIVE_TIMEOUT: i64 = -60;
#[target(os="freebsd")]
pub fun net_connect_pending(code: i64) -> bool {
    return code == -36 || code == -37 || code == -35;
}
#[target(os="windows")]
pub const NET_NATIVE_TIMEOUT: i64 = -10060;
#[target(os="windows")]
pub fun net_connect_pending(code: i64) -> bool {
    return code == -10035 || code == -10036 || code == -10037;
}
#[target(os="none")]
pub const NET_NATIVE_TIMEOUT: i64 = -110;
#[target(os="none")]
pub fun net_connect_pending(code: i64) -> bool {
    return false;
}
#[target(os="unknown")]
pub const NET_NATIVE_TIMEOUT: i64 = -110;
#[target(os="unknown")]
pub fun net_connect_pending(code: i64) -> bool {
    return false;
}
#[target(os="wasi")]
pub const NET_NATIVE_TIMEOUT: i64 = -73;
#[target(os="wasi")]
pub fun net_connect_pending(code: i64) -> bool {
    return false;
}
