import("std::string::len")::{len};

pub fun find_char(s: str, c: u8) -> i32 {
    var i: i32 = 0;

    while (s[i] != 0) {
        if (s[i] == c) {
            return i;
        }

        i += 1;
    }

    return -1;
}

pub fun rfind_char(s: str, c: u8) -> i32 {
    var last: i32 = -1;
    var i: i32 = 0;

    while (s[i] != 0) {
        if (s[i] == c) {
            last = i;
        }

        i += 1;
    }

    return last;
}

pub fun contains_char(s: str, c: u8) -> bool {
    if (find_char(s, c) != -1) {
        return true;
    }

    return false;
}

pub fun count_char(s: str, c: u8) -> i32 {
    var i: i32 = 0;
    var count: i32 = 0;

    while (s[i] != 0) {
        if (s[i] == c) {
            count += 1;
        }

        i += 1;
    }

    return count;
}

pub fun find(s: str, needle: str) -> i32 {
    if (needle[0] == 0) {
        return 0;
    }

    var nl: i32 = 0;
    while (needle[nl] != 0) {
        nl += 1;
    }

    var sl: i32 = 0;
    while (s[sl] != 0) {
        sl += 1;
    }

    if (nl > sl) {
        return -1;
    }

    var i: i32 = 0;
    while (i <= (sl - nl)) {
        var j: i32 = 0;
        var ok: bool = true;

        while (j < nl) {
            var idx: i32 = i + j;
            if (s[idx] != needle[j]) {
                ok = false;
                j = nl;
            } else {
                j += 1;
            }
        }

        if (ok) {
            return i;
        }

        i += 1;
    }

    return -1;
}

// Return the last matching byte offset, or -1. An empty needle matches the end.
// Inputs are NUL-terminated strings; neither is modified and nothing is allocated.
pub fun rfind(s: str, needle: str) -> i32 {
    var sl: i32 = len(s);
    var nl: i32 = len(needle);

    if (nl > sl) {
        return -1;
    }

    if (nl == 0) {
        return sl;
    }

    var i: i32 = sl - nl;
    while (true) {
        var j: i32 = 0;
        var ok: bool = true;

        while (j < nl) {
            var idx: i32 = i + j;
            if (s[idx] != needle[j]) {
                ok = false;
                j = nl;
            } else {
                j += 1;
            }
        }

        if (ok) {
            return i;
        }

        if (i == 0) {
            return -1;
        }

        i -= 1;
    }

    return -1;
}

pub fun contains(s: str, needle: str) -> bool {
    if (find(s, needle) != -1) {
        return true;
    }

    return false;
}

pub fun count(s: str, needle: str) -> i32 {
    if (needle[0] == 0) {
        return 0;
    }

    var nl: i32 = 0;
    while (needle[nl] != 0) {
        nl += 1;
    }

    var sl: i32 = 0;
    while (s[sl] != 0) {
        sl += 1;
    }

    if (nl > sl) {
        return 0;
    }

    var i: i32 = 0;
    var total: i32 = 0;

    while (i <= (sl - nl)) {
        var j: i32 = 0;
        var ok: bool = true;

        while (j < nl) {
            var idx: i32 = i + j;
            if (s[idx] != needle[j]) {
                ok = false;
                j = nl;
            } else {
                j += 1;
            }
        }

        if (ok) {
            total += 1;
            i += nl;
        } else {
            i += 1;
        }
    }

    return total;
}
