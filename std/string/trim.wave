import("std::string::ascii")::{is_space};

pub fun trim_left_index(s: str) -> i32 {
    var i: i32 = 0;

    while (s[i] != 0) {
        var c: u8 = s[i];

        if (is_space(c)) {
            i += 1;
        } else {
            return i;
        }
    }

    return i;
}

pub fun trim_right_index(s: str) -> i32 {
    var sl: i32 = 0;

    while (s[sl] != 0) {
        sl += 1;
    }

    if (sl == 0) {
        return 0;
    }

    var i: i32 = sl - 1;

    while (i >= 0) {
        var c: u8 = s[i];

        if (is_space(c)) {
            i -= 1;
        } else {
            return i + 1;
        }
    }

    return 0;
}

pub fun trim_range(s: str, out_start: ptr<i32>, out_end: ptr<i32>) {
    var start: i32 = trim_left_index(s);
    var end: i32 = trim_right_index(s);

    deref out_start = start;
    deref out_end = end;
}
