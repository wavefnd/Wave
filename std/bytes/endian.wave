// Endian primitives operate byte by byte, so their source and destination do
// not need integer alignment. Raw load/store callers must provide enough data.

pub fun bytes_swap_u16(value: u16) -> u16 {
    return ((value & 0x00FF) << 8)
         | ((value >> 8) & 0x00FF);
}

pub fun bytes_swap_u32(value: u32) -> u32 {
    return ((value & 0x000000FF) << 24)
         | ((value & 0x0000FF00) << 8)
         | ((value >> 8) & 0x0000FF00)
         | ((value >> 24) & 0x000000FF);
}

pub fun bytes_swap_u64(value: u64) -> u64 {
    return ((value & 0x00000000000000FF) << 56)
         | ((value & 0x000000000000FF00) << 40)
         | ((value & 0x0000000000FF0000) << 24)
         | ((value & 0x00000000FF000000) << 8)
         | ((value >> 8) & 0x00000000FF000000)
         | ((value >> 24) & 0x0000000000FF0000)
         | ((value >> 40) & 0x000000000000FF00)
         | ((value >> 56) & 0x00000000000000FF);
}

pub fun bytes_swap_i16(value: i16) -> i16 {
    return bytes_swap_u16(value as u16) as i16;
}

pub fun bytes_swap_i32(value: i32) -> i32 {
    return bytes_swap_u32(value as u32) as i32;
}

pub fun bytes_swap_i64(value: i64) -> i64 {
    return bytes_swap_u64(value as u64) as i64;
}

// Compatibility spellings retain the old signed API without its sign-extension bug.
pub fun bytes_swap16(value: i16) -> i16 { return bytes_swap_i16(value); }
pub fun bytes_swap32(value: i32) -> i32 { return bytes_swap_i32(value); }
pub fun bytes_swap64(value: i64) -> i64 { return bytes_swap_i64(value); }

pub fun bytes_load_be_u16(src: ptr<u8>) -> u16 {
    return ((src[0] as u16) << 8) | (src[1] as u16);
}

pub fun bytes_load_le_u16(src: ptr<u8>) -> u16 {
    return (src[0] as u16) | ((src[1] as u16) << 8);
}

pub fun bytes_store_be_u16(dst: ptr<u8>, value: u16) {
    deref dst[0] = ((value >> 8) & 0xFF) as u8;
    deref dst[1] = (value & 0xFF) as u8;
}

pub fun bytes_store_le_u16(dst: ptr<u8>, value: u16) {
    deref dst[0] = (value & 0xFF) as u8;
    deref dst[1] = ((value >> 8) & 0xFF) as u8;
}

pub fun bytes_load_be_u32(src: ptr<u8>) -> u32 {
    return ((src[0] as u32) << 24)
         | ((src[1] as u32) << 16)
         | ((src[2] as u32) << 8)
         | (src[3] as u32);
}

pub fun bytes_load_le_u32(src: ptr<u8>) -> u32 {
    return (src[0] as u32)
         | ((src[1] as u32) << 8)
         | ((src[2] as u32) << 16)
         | ((src[3] as u32) << 24);
}

pub fun bytes_store_be_u32(dst: ptr<u8>, value: u32) {
    deref dst[0] = ((value >> 24) & 0xFF) as u8;
    deref dst[1] = ((value >> 16) & 0xFF) as u8;
    deref dst[2] = ((value >> 8) & 0xFF) as u8;
    deref dst[3] = (value & 0xFF) as u8;
}

pub fun bytes_store_le_u32(dst: ptr<u8>, value: u32) {
    deref dst[0] = (value & 0xFF) as u8;
    deref dst[1] = ((value >> 8) & 0xFF) as u8;
    deref dst[2] = ((value >> 16) & 0xFF) as u8;
    deref dst[3] = ((value >> 24) & 0xFF) as u8;
}

pub fun bytes_load_be_u64(src: ptr<u8>) -> u64 {
    return ((src[0] as u64) << 56)
         | ((src[1] as u64) << 48)
         | ((src[2] as u64) << 40)
         | ((src[3] as u64) << 32)
         | ((src[4] as u64) << 24)
         | ((src[5] as u64) << 16)
         | ((src[6] as u64) << 8)
         | (src[7] as u64);
}

pub fun bytes_load_le_u64(src: ptr<u8>) -> u64 {
    return (src[0] as u64)
         | ((src[1] as u64) << 8)
         | ((src[2] as u64) << 16)
         | ((src[3] as u64) << 24)
         | ((src[4] as u64) << 32)
         | ((src[5] as u64) << 40)
         | ((src[6] as u64) << 48)
         | ((src[7] as u64) << 56);
}

pub fun bytes_store_be_u64(dst: ptr<u8>, value: u64) {
    deref dst[0] = ((value >> 56) & 0xFF) as u8;
    deref dst[1] = ((value >> 48) & 0xFF) as u8;
    deref dst[2] = ((value >> 40) & 0xFF) as u8;
    deref dst[3] = ((value >> 32) & 0xFF) as u8;
    deref dst[4] = ((value >> 24) & 0xFF) as u8;
    deref dst[5] = ((value >> 16) & 0xFF) as u8;
    deref dst[6] = ((value >> 8) & 0xFF) as u8;
    deref dst[7] = (value & 0xFF) as u8;
}

pub fun bytes_store_le_u64(dst: ptr<u8>, value: u64) {
    deref dst[0] = (value & 0xFF) as u8;
    deref dst[1] = ((value >> 8) & 0xFF) as u8;
    deref dst[2] = ((value >> 16) & 0xFF) as u8;
    deref dst[3] = ((value >> 24) & 0xFF) as u8;
    deref dst[4] = ((value >> 32) & 0xFF) as u8;
    deref dst[5] = ((value >> 40) & 0xFF) as u8;
    deref dst[6] = ((value >> 48) & 0xFF) as u8;
    deref dst[7] = ((value >> 56) & 0xFF) as u8;
}

pub fun bytes_load_be_i16(src: ptr<u8>) -> i16 { return bytes_load_be_u16(src) as i16; }
pub fun bytes_load_le_i16(src: ptr<u8>) -> i16 { return bytes_load_le_u16(src) as i16; }
pub fun bytes_load_be_i32(src: ptr<u8>) -> i32 { return bytes_load_be_u32(src) as i32; }
pub fun bytes_load_le_i32(src: ptr<u8>) -> i32 { return bytes_load_le_u32(src) as i32; }
pub fun bytes_load_be_i64(src: ptr<u8>) -> i64 { return bytes_load_be_u64(src) as i64; }
pub fun bytes_load_le_i64(src: ptr<u8>) -> i64 { return bytes_load_le_u64(src) as i64; }

pub fun bytes_store_be_i16(dst: ptr<u8>, value: i16) { bytes_store_be_u16(dst, value as u16); }
pub fun bytes_store_le_i16(dst: ptr<u8>, value: i16) { bytes_store_le_u16(dst, value as u16); }
pub fun bytes_store_be_i32(dst: ptr<u8>, value: i32) { bytes_store_be_u32(dst, value as u32); }
pub fun bytes_store_le_i32(dst: ptr<u8>, value: i32) { bytes_store_le_u32(dst, value as u32); }
pub fun bytes_store_be_i64(dst: ptr<u8>, value: i64) { bytes_store_be_u64(dst, value as u64); }
pub fun bytes_store_le_i64(dst: ptr<u8>, value: i64) { bytes_store_le_u64(dst, value as u64); }

pub fun bytes_is_little_endian() -> bool {
    var marker: u16 = 1;
    var first: ptr<u8> = &marker as ptr<u8>;
    return first[0] == 1;
}

pub fun bytes_is_big_endian() -> bool { return !bytes_is_little_endian(); }

pub fun bytes_to_be_u16(value: u16) -> u16 {
    if (bytes_is_little_endian()) { return bytes_swap_u16(value); }
    return value;
}

pub fun bytes_from_be_u16(value: u16) -> u16 { return bytes_to_be_u16(value); }

pub fun bytes_to_le_u16(value: u16) -> u16 {
    if (bytes_is_big_endian()) { return bytes_swap_u16(value); }
    return value;
}

pub fun bytes_from_le_u16(value: u16) -> u16 { return bytes_to_le_u16(value); }

pub fun bytes_to_be_u32(value: u32) -> u32 {
    if (bytes_is_little_endian()) { return bytes_swap_u32(value); }
    return value;
}

pub fun bytes_from_be_u32(value: u32) -> u32 { return bytes_to_be_u32(value); }

pub fun bytes_to_le_u32(value: u32) -> u32 {
    if (bytes_is_big_endian()) { return bytes_swap_u32(value); }
    return value;
}

pub fun bytes_from_le_u32(value: u32) -> u32 { return bytes_to_le_u32(value); }

pub fun bytes_to_be_u64(value: u64) -> u64 {
    if (bytes_is_little_endian()) { return bytes_swap_u64(value); }
    return value;
}

pub fun bytes_from_be_u64(value: u64) -> u64 { return bytes_to_be_u64(value); }

pub fun bytes_to_le_u64(value: u64) -> u64 {
    if (bytes_is_big_endian()) { return bytes_swap_u64(value); }
    return value;
}

pub fun bytes_from_le_u64(value: u64) -> u64 { return bytes_to_le_u64(value); }

// Byte-wise accesses preserve alignment independence at 8 bits.
pub fun bytes_load_be_u8(src: ptr<u8>) -> u8 {
    var value: u8 = 0;
    var i: i64 = 0;
    while (i < 1) {
        value = value | (src[1 - 1 - i] as u8) << (i * 8);
        i += 1;
    }
    return value;
}

pub fun bytes_store_be_u8(dst: ptr<u8>, value: u8) {
    var i: i64 = 0;
    while (i < 1) {
        deref dst[1 - 1 - i] = (value >> (i * 8)) as u8;
        i += 1;
    }
}

pub fun bytes_load_be_i8(src: ptr<u8>) -> i8 {
    return bytes_load_be_u8(src) as i8;
}

pub fun bytes_store_be_i8(dst: ptr<u8>, value: i8) {
    bytes_store_be_u8(dst, value as u8);
}

