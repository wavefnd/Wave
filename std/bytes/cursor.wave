pub fun bytes_writer_write_exact(writer: ptr<ByteWriter>, src: Bytes) -> i32 {
    if (!_bytes_writer_is_valid(writer)) { return BYTES_ERROR_INVALID; }
    var dst: BytesMut = BytesMut { data: deref writer.data, len: deref writer.len };
    var status: i32 = bytes_write_exact(dst, deref writer.position, src);
    if (status != BYTES_OK) { return status; }
    deref writer.position = deref writer.position + src.len;
    return BYTES_OK;
}

// The returned range borrows the reader storage. Commit the cursor only on success.
pub fun bytes_reader_read_view(reader: ptr<ByteReader>, count: i64, output: ptr<Bytes>) -> i32 {
    if (!_bytes_reader_output_valid(reader, output as ptr<u8>, size_of<Bytes>() as i64)) {
        return BYTES_ERROR_INVALID;
    }
    if (!_bytes_reader_is_valid(reader)) { return BYTES_ERROR_INVALID; }
    var src: Bytes = Bytes { data: reader.data, len: reader.len };
    var status: i32 = bytes_subview(src, reader.position, count, output);
