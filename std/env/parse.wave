import("std::env::consts")::{ENV_ERR_INVALID_KEY, ENV_ERR_NO_SPACE};

pub fun _env_key_len(name: str) -> i64 {
    var n: i64 = 0;

    while (name[n] != 0) {
        if (name[n] == 61) {
            return ENV_ERR_INVALID_KEY;
        }
        n += 1;
    }

    return n;
}

fun _env_match_key_bytes(blob: ptr<u8>, start: i64, name: str, key_len: i64) -> bool {
    var blob_idx: i64 = start;
    var name_idx: i64 = 0;

    while (name_idx < key_len) {
        if (blob[blob_idx] != name[name_idx]) {
            return false;
        }
        blob_idx += 1;
        name_idx += 1;
    }

    return true;
}

pub fun _env_copy_value(
    blob: ptr<u8>,
    begin: i64,
    end: i64,
    dst: ptr<u8>,
    dst_cap: i64
) -> i64 {
    var value_len: i64 = end - begin;

    if (value_len + 1 > dst_cap) {
        return ENV_ERR_NO_SPACE;
    }

    var src_idx: i64 = begin;
    var dst_idx: i64 = 0;
    while (dst_idx < value_len) {
        deref dst[dst_idx] = blob[src_idx];
        src_idx += 1;
        dst_idx += 1;
    }

    deref dst[value_len] = 0;
    return value_len;
}

pub fun _env_parse_i64(raw: ptr<u8>, out_value: ptr<i64>) -> bool {
    if (raw == null || out_value == null) { return false; }
    var i: i64 = 0;
    var sign: i64 = 1;

    if (raw[0] == 45) {
        sign = -1;
        i = 1;
    } else if (raw[0] == 43) {
        i = 1;
    }

    if (raw[i] == 0) {
        return false;
    }

    // Accumulate negatively so i64::MIN never requires a positive magnitude.
    var limit: i64 = -9223372036854775807;
    if (sign < 0) { limit = -9223372036854775808; }
    var value: i64 = 0;
    while (raw[i] != 0) {
        var c: u8 = raw[i];
        if (c < 48 || c > 57) {
            return false;
        }

        var digit: i64 = c - 48;
        if (value < limit / 10) { return false; }
        value *= 10;
        if (value < limit + digit) { return false; }
        value -= digit;
        i += 1;
    }

    if (sign > 0) {
        value = -value;
    }

    deref out_value = value;
    return true;
}


#[target(os="windows")]
import("std::sys::windows::env")::{env_key_matches};
#[target(os="windows")]
pub fun _env_match_key_sized(blob: ptr<u8>, start: i64, entry_len: i64, name: str, key_len: i64) -> i32 {
    return env_key_matches(blob + start, entry_len, name as ptr<u8>, key_len);
}

#[target(os="linux")]
pub fun _env_match_key_sized(blob: ptr<u8>, start: i64, entry_len: i64, name: str, key_len: i64) -> i32 {
    if (entry_len != key_len) {
        return 0;
    }
    return _env_match_key_bytes(blob, start, name, key_len) as i32;
}

#[target(os="macos")]
pub fun _env_match_key_sized(blob: ptr<u8>, start: i64, entry_len: i64, name: str, key_len: i64) -> i32 {
    if (entry_len != key_len) {
        return 0;
    }
    return _env_match_key_bytes(blob, start, name, key_len) as i32;
}

#[target(os="freebsd")]
pub fun _env_match_key_sized(blob: ptr<u8>, start: i64, entry_len: i64, name: str, key_len: i64) -> i32 {
    if (entry_len != key_len) {
        return 0;
    }
    return _env_match_key_bytes(blob, start, name, key_len) as i32;
}

#[target(os="wasi")]
pub fun _env_match_key_sized(blob: ptr<u8>, start: i64, entry_len: i64, name: str, key_len: i64) -> i32 {
    if (entry_len != key_len) {
        return 0;
    }
    return _env_match_key_bytes(blob, start, name, key_len) as i32;
}

// Compatibility helper for callers that already established equal byte lengths.
pub fun _env_match_key(blob: ptr<u8>, start: i64, name: str, key_len: i64) -> bool {
    return _env_match_key_sized(blob, start, key_len, name, key_len) == 1;
}
