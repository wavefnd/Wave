// Single-threaded linear-memory allocator with splitting and coalescing.
import("std::sys::wasm_blocks")::{MemoryBlock, blocks_reuse, blocks_append, blocks_free};

extern(c, "llvm.wasm.memory.size.i64") fun wasm_memory_size(index: i32) -> i64;
extern(c, "llvm.wasm.memory.grow.i64") fun wasm_memory_grow(index: i32, pages: i64) -> i64;

pub const PROT_READ: i32 = 1;
pub const PROT_WRITE: i32 = 2;
pub const MAP_PRIVATE: i32 = 2;
pub const MAP_ANONYMOUS: i32 = 32;

const WASM_PAGE_SIZE: u64 = 65536;
const MAX_MEMORY: u64 = 18446744073709486080;
static next_address: u64 = 0;
static memory_limit: u64 = 0;
static blocks: ptr<MemoryBlock> = null;
static blocks_tail: ptr<MemoryBlock> = null;
static free_blocks: ptr<MemoryBlock> = null;

fun align16(value: u64) -> u64 {
    return (value + 15) & 18446744073709551600;
}

fun initialize_allocator() -> bool {
    if (memory_limit != 0) {
        return true;
    }
    var pages: i64 = wasm_memory_size(0);
    if (pages < 0 || pages > 281474976710655) {
        return false;
    }
    next_address = pages as u64 * WASM_PAGE_SIZE;
    memory_limit = next_address;
    // Reserve a non-null header when an embedding starts with zero pages.
    if (pages == 0) {
        if (wasm_memory_grow(0, 1) < 0) {
            return false;
        }
        next_address = 16;
        memory_limit = WASM_PAGE_SIZE;
    }
    return true;
}

pub fun sys_alloc(size: i64) -> ptr<u8> {
    if (size <= 0) {
        return null;
    }
    var capacity: u64 = align16(size as u64);
    if (capacity > MAX_MEMORY - 32) {
        return null;
    }
    if (!initialize_allocator()) {
        return null;
    }
    var reused: ptr<u8> = blocks_reuse(&free_blocks, &blocks_tail, size, capacity);
    if (reused != null) {
        return reused;
    }
    var total: u64 = capacity + 32;
    var start: u64 = next_address;
    if (start > MAX_MEMORY - total) {
        return null;
    }
    if (total > memory_limit - start) {
        // Grow complete owned pages. If another user grew linear memory in
        // between, its pages remain outside this allocator's block list.
        var pages: u64 = total / WASM_PAGE_SIZE;
        if (total % WASM_PAGE_SIZE != 0) {
            pages += 1;
        }
        var current: i64 = wasm_memory_size(0);
        if (current < 0 || current as u64 > MAX_MEMORY / WASM_PAGE_SIZE - pages) {
            return null;
        }
        var previous: i64 = wasm_memory_grow(0, pages as i64);
        if (previous < 0) {
            return null;
        }
        start = previous as u64 * WASM_PAGE_SIZE;
        memory_limit = start + pages * WASM_PAGE_SIZE;
    }
    next_address = start + total;
    return blocks_append(&blocks, &blocks_tail, start as ptr<u8>, size, capacity);
}

pub fun sys_free(p: ptr<u8>, size: i64) -> i64 {
    return blocks_free(blocks, &blocks_tail, &free_blocks, p, size);
}

pub fun mmap(
    addr: ptr<i8>, length: i64, prot: i32, flags: i32, fd: i64, offset: i64
) -> ptr<i8> {
    if (addr != null || fd != -1 || offset != 0) {
        return null;
    }
    return sys_alloc(length) as ptr<i8>;
}

pub fun munmap(addr: ptr<i8>, length: i64) -> i64 {
    return sys_free(addr as ptr<u8>, length);
}

pub fun brk(addr: ptr<i8>) -> ptr<i8> {

    return null;

}
pub fun sys_page_size() -> i64 {
    return WASM_PAGE_SIZE as i64;
}
