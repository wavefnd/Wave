fun codec_8(value: u8) -> bool {
    var buffer: array<u8, 3>;
    buffer[0] = 91;
    buffer[2] = 92;
    var dst: BytesMut = bytes_view_mut(&buffer[0], 3);
    var src: Bytes = bytes_view(&buffer[0], 3);
    var output: u8 = 0;
    var signed_output: i8 = 0;
    if (bytes_write_be_u8(dst, 1, value) != 0 || bytes_read_be_u8(src, 1, &output) != 0 || output != value) { return false; }
    var low: u8 = (value & 255) as u8;
    if (buffer[1] != low || buffer[1] != (value >> 0) as u8) { return false; }
    if (bytes_write_le_i8(dst, 1, value as i8) != 0 || bytes_read_le_i8(src, 1, &signed_output) != 0
        || signed_output != value as i8 || buffer[1] != low) { return false; }
    if (bytes_write_be_i8(dst, 1, value as i8) != 0 || bytes_read_be_i8(src, 1, &signed_output) != 0
        || signed_output != value as i8) { return false; }
    if (bytes_write_le_u8(dst, 1, value) != 0 || bytes_read_le_u8(src, 1, &output) != 0 || output != value) { return false; }
    var writer: ByteWriter = bytes_writer(&buffer[1], 1);
    if (bytes_writer_write_be_u8(&writer, value) != 0 || writer.position != 1) { return false; }
    var reader: ByteReader = bytes_reader(&buffer[1], 1);
    if (bytes_reader_peek_be_u8(&reader, &output) != 0 || output != value || reader.position != 0) { return false; }
    if (bytes_reader_peek_be_u8(&reader, &buffer[1] as ptr<u8>) != -1 || reader.position != 0) { return false; }
    if (bytes_reader_read_be_u8(&reader, &output) != 0 || output != value || reader.position != 1) { return false; }
    output = 37;
    if (bytes_reader_read_be_u8(&reader, &output) == 0 || output != 37 || reader.position != 1) { return false; }
    writer.position = 0;
    reader.position = 0;
    if (bytes_writer_write_le_i8(&writer, value as i8) != 0
        || bytes_reader_read_le_i8(&reader, &signed_output) != 0 || signed_output != value as i8) { return false; }
    if (bytes_writer_write_be_u8(&writer, 0) == 0 || writer.position != 1) { return false; }
    if (bytes_read_le_u8(src, 1, &output) != 0 || output != value) { return false; }
    output = 37;
    if (bytes_read_le_u8(bytes_view(&buffer[0], 1), 1, &output) == 0 || output != 37) { return false; }
    if (bytes_write_be_u8(bytes_view_mut(&buffer[0], 1), 1, value) == 0) { return false; }
    if (buffer[0] != 91 || buffer[2] != 92) { return false; }
    return true;
}

