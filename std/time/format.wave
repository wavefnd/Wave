import("std::string::len")::{len};
import("std::time::datetime")::{
    DateTime, DateTimeResult,
    time_datetime_from_parts, time_datetime_is_valid, time_datetime_zero,
};

pub const TIME_FORMAT_INVALID: i64 = -22;
pub const TIME_FORMAT_NO_SPACE: i64 = -28;
pub const TIME_FORMAT_ISO8601_LENGTH: i64 = 30;

fun time_write_digits(value: i64, digits: i32, output: ptr<u8>, start: i64) {
    var divisor: i64 = 1;
    var position: i32 = 1;
    while (position < digits) {
        divisor *= 10;
        position += 1;
    }

    var index: i64 = start;
    var remaining: i64 = value;
    while (divisor > 0) {
        deref output[index] = (48 + ((remaining / divisor) % 10)) as u8;
        divisor /= 10;
        index += 1;
    }
}

// Writes YYYY-MM-DDTHH:MM:SS.NNNNNNNNNZ and returns 30 or a negative error.
pub fun time_datetime_format_iso8601(value: DateTime, output: ptr<u8>, capacity: i64) -> i64 {
    if (!time_datetime_is_valid(value) || value.year < 0 || value.year > 9999) {
        return TIME_FORMAT_INVALID;
    }
    if (output == null || capacity < TIME_FORMAT_ISO8601_LENGTH + 1) {
        return TIME_FORMAT_NO_SPACE;
    }

    time_write_digits(value.year, 4, output, 0);
    deref output[4] = 45;
    time_write_digits(value.month as i64, 2, output, 5);
    deref output[7] = 45;
    time_write_digits(value.day as i64, 2, output, 8);
    deref output[10] = 84;
    time_write_digits(value.hour as i64, 2, output, 11);
    deref output[13] = 58;
    time_write_digits(value.minute as i64, 2, output, 14);
    deref output[16] = 58;
    time_write_digits(value.second as i64, 2, output, 17);
    deref output[19] = 46;
    time_write_digits(value.nanosecond, 9, output, 20);
    deref output[29] = 90;
    deref output[30] = 0;
    return TIME_FORMAT_ISO8601_LENGTH;
}

fun time_parse_digits(text: str, start: i32, count: i32) -> i32 {
    var value: i32 = 0;
    var index: i32 = 0;
    while (index < count) {
        var source_index: i32 = start + index;
        var digit_byte: u8 = text[source_index];
        if (digit_byte < 48 || digit_byte > 57) { return -1; }
        value = (value * 10) + (digit_byte - 48) as i32;
        index += 1;
    }
    return value;
}

// Parses UTC ISO 8601 with whole seconds or one through nine fractional digits.
pub fun time_datetime_parse_iso8601(text: str) -> DateTimeResult {
    var length: i32 = len(text);
    if (length != 20 && (length < 22 || length > 30)) {
        return DateTimeResult { ok: false, value: time_datetime_zero() };
    }
    if (text[4] != 45 || text[7] != 45 || text[10] != 84
        || text[13] != 58 || text[16] != 58) {
        return DateTimeResult { ok: false, value: time_datetime_zero() };
    }
    if (length == 20) {
        if (text[19] != 90) {
            return DateTimeResult { ok: false, value: time_datetime_zero() };
        }
    } else {
        if (text[19] != 46 || text[length - 1] != 90) {
            return DateTimeResult { ok: false, value: time_datetime_zero() };
        }
    }

    var year: i32 = time_parse_digits(text, 0, 4);
    var month: i32 = time_parse_digits(text, 5, 2);
    var day: i32 = time_parse_digits(text, 8, 2);
    var hour: i32 = time_parse_digits(text, 11, 2);
    var minute: i32 = time_parse_digits(text, 14, 2);
    var second: i32 = time_parse_digits(text, 17, 2);
    var nanosecond: i32 = 0;
    if (length != 20) {
        var fractional_digits: i32 = length - 21;
        nanosecond = time_parse_digits(text, 20, fractional_digits);
        if (nanosecond >= 0) {
            while (fractional_digits < 9) {
                nanosecond *= 10;
                fractional_digits += 1;
            }
        }
    }
    if (year < 0 || month < 0 || day < 0 || hour < 0
        || minute < 0 || second < 0 || nanosecond < 0) {
        return DateTimeResult { ok: false, value: time_datetime_zero() };
    }
    return time_datetime_from_parts(
        year as i64, month, day, hour, minute, second, nanosecond as i64
    );
}
