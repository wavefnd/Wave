// =======================================================
// macOS process syscalls
// =======================================================

import("std::sys::macos::arm64::syscall")::{
    syscall0,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall5,
    syscall6,
};

pub fun exit(code: i32) -> ! {
    syscall1(1, code as i64);
    while (true) { }
}

pub fun getpid() -> i64 {
    return syscall0(20);
}

pub fun getppid() -> i64 {
    return syscall0(39);
}

pub fun fork() -> i64 {
    var result: i64;
    var child: i64;
    // Darwin reports the child branch in x1, not by zeroing x0.
    asm {
        "svc #0x80\ncneg x0, x0, cs"
        in("x16") 2
        out("x0") result
        out("x1") child
    }
    if (result < 0) {
        return result;
    }
    if (child != 0) {
        return 0;
    }
    return result;
}

pub fun execve(
    path: str,
    argv: ptr<ptr<i8>>,
    envp: ptr<ptr<i8>>
) -> i64 {
    return syscall3(59, path as i64, argv as i64, envp as i64);
}

pub fun waitpid(pid: i64, status: ptr<i32>, options: i32) -> i64 {
    if (pid < -2147483648 || pid > 2147483647) {
        return -22;
    }
    return syscall4(7, pid, status as i64, options as i64, 0);
}

pub fun kill(pid: i64, sig: i32) -> i64 {
    if (pid < -2147483648 || pid > 2147483647) {
        return -22;
    }
    return syscall2(37, pid, sig as i64);
}
