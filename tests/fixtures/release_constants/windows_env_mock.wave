extern(c) fun choose(n: i32);
extern(c) fun failures() -> i32;
extern(c) fun acquisitions() -> i32;
extern(c) fun releases() -> i32;
extern(c) fun conversions() -> i32;
fun main() -> i32 {
    var data: array<u8, 20>;
    choose(0);
    if (env_read(null, 20) != -22 || env_read(&data[0], 0) != -22 || acquisitions() != 0) { return 1; }
    data[0] = 85;
    if (env_read(&data[0], 18) != -28 || data[0] != 85 || releases() != 1 || conversions() != 0) { return 2; }
    choose(0);
    if (env_read(&data[0], 19) != 19 || releases() != 1 || conversions() != 1) { return 3; }
    var expected: array<u8, 19> = [61,67,58,61,120,0,237,149,156,61,240,159,152,128,0,69,61,0,0];
    var i: i32 = 0;
    while (i < 19) { if (data[i] != expected[i]) { return 4; } i += 1; }
    choose(1);
    if (env_read(&data[0], 20) != -13 || releases() != 0) { return 5; }
    choose(2);
    if (env_read(&data[0], 20) != -13 || releases() != 1 || conversions() != 0) { return 6; }
    choose(3);
    if (env_read(&data[0], 20) != -13 || releases() != 1 || conversions() != 1) { return 7; }
    choose(5);
    if (env_read(&data[0], 20) != -13 || releases() != 1) { return 8; }
    choose(0);
    if (env_key_matches("Path" as ptr<u8>, 4, "PATH" as ptr<u8>, 4) != 1) { return 9; }
    if (env_key_matches("Path" as ptr<u8>, 4, "PAT" as ptr<u8>, 3) != 0) { return 10; }
    if (env_key_matches("Ä" as ptr<u8>, 2, "Ä" as ptr<u8>, 2) != 1) { return 11; }
    choose(6);
    if (env_key_matches("Path" as ptr<u8>, 4, "PATH" as ptr<u8>, 4) != -22) { return 12; }
    choose(7);
    if (env_key_matches("Path" as ptr<u8>, 4, "PATH" as ptr<u8>, 4) != -22) { return 13; }
    return failures();
}
