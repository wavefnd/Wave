option('compiler', type: 'boolean', value: true, description: 'Enable compiler targets; disable for Rust-tooling-only CI/matrix jobs without LLVM')
option('toolchain', type: 'string', value: '', description: 'Rustup toolchain alias; must report the pinned Rust version')
option('compiler_target', type: 'combo', value: 'native', choices: [
    'native',
    'x86_64-unknown-linux-gnu', 'aarch64-unknown-linux-gnu',
    'riscv64gc-unknown-linux-gnu', 'loongarch64-unknown-linux-gnu',
    'x86_64-unknown-freebsd', 'x86_64-unknown-openbsd',
    'x86_64-unknown-netbsd', 'x86_64-unknown-dragonfly',
    'x86_64-unknown-redox', 'x86_64-unknown-fuchsia', 'x86_64-unknown-haiku',
    'x86_64-pc-windows-msvc', 'aarch64-pc-windows-msvc',
    'aarch64-apple-darwin', 'x86_64-apple-darwin',
], description: 'Host of the built wavec executable; native keeps Cargo host output paths')
option('llvm_features', type: 'combo', value: 'auto', choices: [
    'auto', 'default', 'llvm-target-core64', 'llvm-target-all',
    'llvm-target-x86', 'llvm-target-aarch64', 'llvm-target-riscv',
    'llvm-target-loongarch', 'llvm-target-wasm',
], description: 'Cargo LLVM feature set; auto uses the existing native Windows release selection')
option('cargo_target_dir', type: 'string', value: 'target',
    description: 'Cargo output directory, relative to the source root or absolute')
option('llvm_prefix', type: 'string', value: '', description: 'LLVM 21 prefix; empty inherits environment')
