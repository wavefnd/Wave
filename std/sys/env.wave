// Selects the target environment ABI. std::env adds caller-buffer validation
// and value parsing on top of this raw environment reader.

#[target(os="linux")]
pub import("std::sys::linux::env")::{
    env_read,
};

#[target(os="macos")]
pub import("std::sys::macos::env")::{
    ERR_NOT_IMPLEMENTED,
    env_read,
};

#[target(os="windows")]
pub import("std::sys::windows::env")::{env_read};

#[target(os="freebsd")]
pub import("std::sys::freebsd::env")::{env_read, env_required_capacity};

#[target(os="wasi")]
pub import("std::sys::wasm::env")::{env_read, ENV_READ_NEEDS_SPACE};
