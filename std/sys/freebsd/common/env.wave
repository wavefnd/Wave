import("std::sys::freebsd::syscall")::{syscall0, syscall6};

// Kept for callers that used the original provider constant.
pub const ERR_NOT_IMPLEMENTED: i64 = -78;

// Query separately so ENOMEM from an actual read is never assumed to mean
// capacity exhaustion without confirming the provider's required source size.
pub fun env_required_capacity() -> i64 {
    var pid: i64 = syscall0(20);
    if (pid < 0) {
        return pid;
    }
    var name: array<i32, 4> = [1, 14, 35, pid as i32];
    var length: u64 = 0;
    var status: i64 = syscall6(202, &name[0] as i64, 4, 0, &length as i64, 0, 0);
    if (status < 0) {
        return status;
    }
    if (length > 9223372036854775807) {
        return -75;
    }
    return length as i64;
}

pub fun env_read(buf: ptr<u8>, cap: i64) -> i64 {
    if (buf == null || cap <= 0) { return -22; }
    var needed: i64 = env_required_capacity();
    if (needed < 0) {
        return needed;
    }
    if (needed > cap) {
        return -28;
    }
    // CTL_KERN / KERN_PROC / KERN_PROC_ENV / pid returns NUL-separated entries.
    var pid: i64 = syscall0(20);
    if (pid < 0) { return pid; }
    var name: array<i32, 4> = [1, 14, 35, pid as i32];
    var length: u64 = cap as u64;
    var status: i64 = syscall6(202, &name[0] as i64, 4, buf as i64, &length as i64, 0, 0);
    if (status == -12) {
        var latest: i64 = env_required_capacity();
        if (latest > cap) {
            return -28;
        }
    }
    if (status < 0) { return status; }
    if (length > cap as u64) {
        return -28;
    }
    return length as i64;
}
