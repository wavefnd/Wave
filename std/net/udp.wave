pub fun udp_set_multicast_hops_v6(sock: UdpSocket, hops: i32) -> NetError {
    if (sock.family != NET_ADDRESS_IPV6) { return net_error_from_native(-22); }
    return _udp_option_error(net_set_multicast_hops_v6(sock.fd, hops));
}

pub fun udp_multicast_hops_v6(sock: UdpSocket) -> NetResult<i64> {
    if (sock.family != NET_ADDRESS_IPV6) {
        return net_result_err<i64>(0, net_error_from_native(-22));
    }
    return _udp_option_i64(net_get_multicast_hops_v6(sock.fd));
