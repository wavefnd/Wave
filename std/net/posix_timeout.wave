// SPDX-License-Identifier: Apache-2.0
// A readiness event can be consumed by an alias before our syscall. Each I/O
// attempt must itself be nonblocking; never change the shared descriptor mode.
import("std::sys::socket")::{send, recv, MSG_NOSIGNAL};
#[target(os="linux")]
import("std::sys::socket")::{MSG_DONTWAIT};
#[target(os="macos")]
import("std::sys::socket")::{MSG_DONTWAIT};
#[target(os="freebsd")]
import("std::sys::socket")::{MSG_DONTWAIT};

import("std::net::poll")::{net_wait_readable, net_wait_writable};
import("std::net::socket_base")::{net_fd_valid};
import("std::net::error")::{
    NetIoResult, NetError, net_io_ok, net_io_eof, net_io_error,
    net_error, net_error_from_native, NET_ERROR_INTERRUPTED, NET_ERROR_WOULD_BLOCK,
    NET_ERROR_TIMED_OUT,
};
import("std::time::clock")::{time_now_monotonic_ns};

// Only POSIX targets expose this entry point. The retry body receives its
// flags explicitly so checking this file on Windows needs no invented constant.
#[target(os="linux")]
pub fun net_io_timeout(fd: i64, buffer: ptr<u8>, size: i64, timeout_ms: i32, writing: bool) -> NetIoResult {
    return _net_io_timeout(fd, buffer, size, timeout_ms, writing, MSG_DONTWAIT);
}
#[target(os="macos")]
pub fun net_io_timeout(fd: i64, buffer: ptr<u8>, size: i64, timeout_ms: i32, writing: bool) -> NetIoResult {
    return _net_io_timeout(fd, buffer, size, timeout_ms, writing, MSG_DONTWAIT);
}
#[target(os="freebsd")]
pub fun net_io_timeout(fd: i64, buffer: ptr<u8>, size: i64, timeout_ms: i32, writing: bool) -> NetIoResult {
    return _net_io_timeout(fd, buffer, size, timeout_ms, writing, MSG_DONTWAIT);
}

fun _net_io_timeout(fd: i64, buffer: ptr<u8>, size: i64, timeout_ms: i32, writing: bool, nonblock: i32) -> NetIoResult {
    // send/recv narrow the descriptor to a native i32 before checking it.
    if (size > 0 && !net_fd_valid(fd)) {
        return net_io_error(0, -22);
    }
    var start: i64 = 0;
    if (timeout_ms >= 0) {
        start = time_now_monotonic_ns();
        if (start < 0) {
            return net_io_error(0, start);
        }
    }
    var budget: i64 = timeout_ms as i64 * 1000000;
    while (true) {
        var count: i64 = 0;
        if (writing) {
            count = send(fd, buffer, size, nonblock | MSG_NOSIGNAL);
        } else {
            count = recv(fd, buffer, size, nonblock);
        }
        if (count >= 0) {
            if (!writing && count == 0) {
                return net_io_eof(0);
            }
            return net_io_ok(count);
        }
        var error: NetError = net_error_from_native(count);
        if (error.kind != NET_ERROR_INTERRUPTED && error.kind != NET_ERROR_WOULD_BLOCK) {
            return net_io_error(0, count);
        }

        var remaining: i32 = -1;
        if (timeout_ms >= 0) {
            var now: i64 = time_now_monotonic_ns();
            if (now < 0) {
                return net_io_error(0, now);
            }
            if (now < start) {
                return net_io_error(0, -5);
            }
            var elapsed: i64 = now - start;
            if (elapsed >= budget) {
                return _net_io_timed_out();
            }
            remaining = ((budget - elapsed + 999999) / 1000000) as i32;
        }
        var ready: i64 = 0;
        if (writing) {
            ready = net_wait_writable(fd, remaining);
        } else {
            ready = net_wait_readable(fd, remaining);
        }
        if (ready == 0) {
            return _net_io_timed_out();
        }
        if (ready < 0) {
            error = net_error_from_native(ready);
            if (error.kind != NET_ERROR_INTERRUPTED) {
                return net_io_error(0, ready);
            }
        }
        // The next EAGAIN or EINTR recomputes the same monotonic budget.
    }
    return net_io_error(0, -5);
}

fun _net_io_timed_out() -> NetIoResult {
    // A local deadline or poll timeout has no native errno to preserve.
    return NetIoResult { count: 0, eof: false, error: net_error(NET_ERROR_TIMED_OUT, 0) };
}
