import("std::sys::env")::{
    env_read,
};
import("std::env::parse")::{
    _env_key_len,
    _env_match_key_sized,
    _env_copy_value,
    _env_parse_i64,
};

import("std::env::consts")::{
    ENV_ERR_NO_SPACE, ENV_ERR_NOT_FOUND, ENV_ERR_INVALID_KEY,
    ENV_ERR_READ, ENV_ERR_SOURCE_INCOMPLETE, ENV_ERR_NO_MEMORY
};
import("std::sys::memory")::{sys_alloc, sys_free};

// Raw OS error domains differ. Retry only the provider's source-capacity
// status, never its bounded entry-limit failure or an ordinary host error.
#[target(os="wasi")]
import("std::sys::env")::{ENV_READ_NEEDS_SPACE};
#[target(os="linux")]
fun _env_source_needs_space(status: i64) -> bool { return status == -28; }
#[target(os="windows")]
fun _env_source_needs_space(status: i64) -> bool { return status == -28; }
#[target(os="macos")]
fun _env_source_needs_space(status: i64) -> bool { return status == -28; }
#[target(os="freebsd")]
fun _env_source_needs_space(status: i64) -> bool {
    return status == -28;
}
#[target(os="wasi")]
fun _env_source_needs_space(status: i64) -> bool { return status == ENV_READ_NEEDS_SPACE; }

pub struct EnvResult<T> {
    ok: bool;
    value: T;
}

pub fun env_result_ok<T>(value: T) -> EnvResult<T> {
    var result: EnvResult<T>;
    result.ok = true;
    result.value = value;
    return result;
}

pub fun env_result_err<T>(fallback: T) -> EnvResult<T> {
    var result: EnvResult<T>;
    result.ok = false;
    result.value = fallback;
    return result;
}

pub fun env_unwrap_or<T>(result: EnvResult<T>, default_value: T) -> T {
    if (result.ok) {
        return result.value;
    }

    return default_value;
}

#[target(os="freebsd")]
import("std::sys::env")::{env_required_capacity};
#[target(os="freebsd")]
fun _env_next_capacity(current: i64, reads: i32) -> i64 {
    if (reads >= 3) {
        return ENV_ERR_SOURCE_INCOMPLETE;
    }
    var required: i64 = env_required_capacity();
    if (required < 0) {
        return ENV_ERR_READ;
    }
    var next: i64 = required;
    if (next <= current) {
        next = current * 2;
    }
    if (next > 16777216) {
        return ENV_ERR_SOURCE_INCOMPLETE;
    }
    return next;
}
#[target(os="linux")]
fun _env_next_capacity(current: i64, reads: i32) -> i64 {
    if (current > 4611686018427387903) {
        return ENV_ERR_NO_MEMORY;
    }
    return current * 2;
}
#[target(os="windows")]
fun _env_next_capacity(current: i64, reads: i32) -> i64 {
    if (current > 4611686018427387903) {
        return ENV_ERR_NO_MEMORY;
    }
    return current * 2;
}
#[target(os="macos")]
fun _env_next_capacity(current: i64, reads: i32) -> i64 {
    if (current > 4611686018427387903) {
        return ENV_ERR_NO_MEMORY;
    }
    return current * 2;
}
#[target(os="wasi")]
fun _env_next_capacity(current: i64, reads: i32) -> i64 {
    if (current > 4611686018427387903) {
        return ENV_ERR_NO_MEMORY;
    }
    return current * 2;
}

// POSIX keys compare exact UTF-8 bytes; Windows uses native ordinal Unicode
// case-insensitive comparison. Hidden Windows drive entries are not keys.
// FreeBSD source reads stop after three attempts or 16 MiB, leaving dst intact.
pub fun env_get(name: str, dst: ptr<u8>, dst_cap: i64) -> i64 {
    var key_len: i64 = _env_key_len(name);
    if (key_len <= 0) { return ENV_ERR_INVALID_KEY; }
    if (dst == null || dst_cap <= 0) { return ENV_ERR_NO_SPACE; }

    var initial: array<u8, 32768>;
    var raw: ptr<u8> = &initial[0];
    var capacity: i64 = 32768;
    var allocated: bool = false;
    var reads: i32 = 1;
    var n: i64 = env_read(raw, capacity);
    while (_env_source_needs_space(n)) {
        var next: i64 = _env_next_capacity(capacity, reads);
        if (allocated) { sys_free(raw, capacity); }
        if (next < 0) {
            return next;
        }
        capacity = next;
        raw = sys_alloc(capacity);
        if (raw == null) { return ENV_ERR_NO_MEMORY; }
        allocated = true;
        reads += 1;
        n = env_read(raw, capacity);
    }
    var result: i64 = ENV_ERR_READ;
    if (n >= 0 && n <= capacity) {
        result = _env_lookup(raw, n, name, key_len, dst, dst_cap);
    }
    if (allocated) { sys_free(raw, capacity); }
    return result;
}

fun _env_lookup(raw: ptr<u8>, n: i64, name: str, key_len: i64, dst: ptr<u8>, dst_cap: i64) -> i64 {
    if (n == 0) { return ENV_ERR_NOT_FOUND; }
    // An unterminated source entry is neither a complete value nor proof that
    // an absent key does not exist beyond the buffer boundary.
    if (raw[n - 1] != 0) { return ENV_ERR_SOURCE_INCOMPLETE; }

    var i: i64 = 0;
    while (i < n) {
        var entry_start: i64 = i;
        var eq_pos: i64 = -1;

        while (i < n && raw[i] != 0) {
            if (raw[i] == 61 && eq_pos < 0) {
                eq_pos = i;
            }
            i += 1;
        }

        var entry_end: i64 = i;

        if (i < n) {
            i += 1;
        }

        if (eq_pos <= entry_start) {
            continue;
        }

        var matched: i32 = _env_match_key_sized(&raw[0], entry_start, eq_pos - entry_start, name, key_len);
        if (matched == -12) {
            return ENV_ERR_NO_MEMORY;
        }
        if (matched < 0) {
            return ENV_ERR_READ;
        }
        if (matched == 0) {
            continue;
        }

        return _env_copy_value(&raw[0], eq_pos + 1, entry_end, dst, dst_cap);
    }

    return ENV_ERR_NOT_FOUND;
}

pub fun env_exists(name: str) -> bool {
    // A one-byte probe copies only the terminator of an empty value.
    // NO_SPACE also proves the key exists, without copying its value.
    var tmp: array<u8, 1>;
    var r: i64 = env_get(name, &tmp[0], 1);
    return r >= 0 || r == ENV_ERR_NO_SPACE;
}

pub fun env_get_i64(name: str) -> EnvResult<i64> {
    var raw: array<u8, 64>;
    var n: i64 = env_get(name, &raw[0], 64);

    if (n <= 0) {
        return env_result_err<i64>(0);
    }

    var parsed: i64 = 0;
    if (!_env_parse_i64(&raw[0], &parsed)) {
        return env_result_err<i64>(0);
    }

    return env_result_ok<i64>(parsed);
}

pub fun env_get_i32(name: str) -> EnvResult<i32> {
    var raw: array<u8, 64>;
    var n: i64 = env_get(name, &raw[0], 64);

    if (n <= 0) {
        return env_result_err<i32>(0);
    }

    var parsed_i64: i64 = 0;
    if (!_env_parse_i64(&raw[0], &parsed_i64)) {
        return env_result_err<i32>(0);
    }

    if (parsed_i64 < -2147483648 || parsed_i64 > 2147483647) {
        return env_result_err<i32>(0);
    }

    return env_result_ok<i32>(parsed_i64 as i32);
}

pub fun env_get_i32_default(name: str, default_value: i32) -> i32 {
    return env_unwrap_or<i32>(env_get_i32(name), default_value);
}

pub fun env_get_i64_default(name: str, default_value: i64) -> i64 {
    return env_unwrap_or<i64>(env_get_i64(name), default_value);
}
