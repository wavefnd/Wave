pub fun bytes_reader_read_u8(reader: ptr<ByteReader>, out_value: ptr<u8>) -> i32 {
    if (!_bytes_reader_output_valid(reader, out_value as ptr<u8>, 1)) {
        return BYTES_ERROR_INVALID;
    }
    if (!_bytes_reader_is_valid(reader)) { return BYTES_ERROR_INVALID; }
    var src: Bytes = Bytes { data: deref reader.data, len: deref reader.len };
    var status: i32 = bytes_read_u8(src, deref reader.position, out_value);
    if (status != BYTES_OK) { return status; }
    deref reader.position = deref reader.position + 1;
    return BYTES_OK;
}

pub fun bytes_reader_read_be_u16(reader: ptr<ByteReader>, out_value: ptr<u16>) -> i32 {
    if (!_bytes_reader_output_valid(reader, out_value as ptr<u8>, 2)) {
