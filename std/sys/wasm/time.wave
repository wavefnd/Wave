// WASI Preview 1 clocks and monotonic deadline sleep through poll_oneoff.

extern(c, "clock_time_get") fun wasi_clock_time_get(
    clock_id: u32, precision: u64, timestamp: ptr<u64>
) -> u16;
extern(c, "poll_oneoff") fun wasi_poll_oneoff(
    subscriptions: ptr<WasiSubscription>, events: ptr<WasiEvent>,
    count: u32, event_count: ptr<u32>
) -> u16;

struct WasiSubscriptionClock {
    clock_id: u32;
    timeout: u64;
    precision: u64;
    flags: u16;
}

struct WasiSubscription {
    userdata: u64;
    event_type: u8;
    clock: WasiSubscriptionClock;
}

struct WasiEventFd {
    byte_count: u64;
    flags: u16;
}

struct WasiEvent {
    userdata: u64;
    error: u16;
    event_type: u8;
    fd: WasiEventFd;
}

pub struct TimeSpec {
    sec: i64;
    nsec: i64;
}

pub fun clock_gettime(clock_id: i32, tp: ptr<TimeSpec>) -> i64 {
    if (tp == null || clock_id < 0 || clock_id > 3) { return -22; }
    var timestamp: u64 = 0;
    var error: u16 = wasi_clock_time_get(clock_id as u32, 1, &timestamp);
    if (error != 0) { return -(error as i64); }
    // Split unsigned nanoseconds first: both fields fit i64 even at u64::MAX.
    deref tp.sec = (timestamp / 1000000000) as i64;
    deref tp.nsec = (timestamp % 1000000000) as i64;
    return 0;
}

const WASI_TIMESTAMP_MAX: u64 = 18446744073709551615;

pub fun nanosleep(req: ptr<TimeSpec>, rem: ptr<TimeSpec>) -> i64 {
    if (req == null) { return -28; }
    // Snapshot the request before initializing rem: callers may alias the two.
    var seconds: i64 = deref req.sec;
    var nanoseconds: i64 = deref req.nsec;
    if (rem != null) { deref rem = TimeSpec { sec: 0, nsec: 0 }; }
    if (seconds < 0 || nanoseconds < 0 || nanoseconds >= 1000000000) { return -28; }
    if (seconds > 18446744073) { return -61; }
    if (seconds == 18446744073 && nanoseconds > 709551615) { return -61; }
    var timeout: u64 = seconds as u64 * 1000000000 + nanoseconds as u64;
    if (timeout == 0) { return 0; }
    var start: u64 = 0;
    var error: u16 = wasi_clock_time_get(1, 1, &start);
    if (error != 0) { return -(error as i64); }
    if (timeout > WASI_TIMESTAMP_MAX - start) { return -61; }
    var deadline: u64 = start + timeout;
    // Keep the deadline for interruption accounting; request a relative wait
    // so hosts need not implement absolute monotonic subscriptions.
    var clock: WasiSubscriptionClock = WasiSubscriptionClock {
        clock_id: 1, timeout: timeout, precision: 1, flags: 0
    };
    var subscription: WasiSubscription = WasiSubscription {
        userdata: 1, event_type: 0, clock: clock
    };
    var event: WasiEvent;
    var count: u32 = 0;
    error = wasi_poll_oneoff(&subscription, &event, 1, &count);
    if (error == 0) {
        if (count != 1) { return -29; }
        error = event.error;
    }
    if (error == 27 && rem != null) {
        var now: u64 = 0;
        var clock_error: u16 = wasi_clock_time_get(1, 1, &now);
        if (clock_error != 0) { return -(clock_error as i64); }
        if (now < deadline) {
            var remaining: u64 = deadline - now;
            deref rem.sec = (remaining / 1000000000) as i64;
            deref rem.nsec = (remaining % 1000000000) as i64;
        }
    }
    return -(error as i64);
}
