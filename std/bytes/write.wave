pub import("std::bytes::types")::{Bytes, BytesMut};
pub import("std::bytes::errors")::{
    BYTES_OK,
    BYTES_ERROR_INVALID,
    BYTES_ERROR_EOF,
    BYTES_ERROR_NO_SPACE,
    BYTES_ERROR_OVERFLOW,
};
import("std::bytes::endian")::{
    bytes_store_be_u8,
    bytes_store_le_u8,
    bytes_store_be_u128,
    bytes_store_le_u128,
    bytes_store_be_u256,
    bytes_store_le_u256,
    bytes_store_be_u512,
    bytes_store_le_u512,
    bytes_store_be_u1024,
    bytes_store_le_u1024,

    bytes_store_be_u16,
    bytes_store_le_u16,
    bytes_store_be_u32,
    bytes_store_le_u32,
    bytes_store_be_u64,
    bytes_store_le_u64,
};
import("std::mem::ops")::{mem_move};

fun _bytes_check_write(dst: BytesMut, offset: i64, width: i64) -> i32 {
    if (dst.len < 0 || offset < 0 || width < 0) {
        return BYTES_ERROR_INVALID;
    }
    if (dst.len > 0 && dst.data == null) {
        return BYTES_ERROR_INVALID;
    }
    if (offset > dst.len) {
        return BYTES_ERROR_NO_SPACE;
    }
    if (width > dst.len - offset) {
        return BYTES_ERROR_NO_SPACE;
    }
    return BYTES_OK;
}

pub fun bytes_write_u8(dst: BytesMut, offset: i64, value: u8) -> i32 {
    var status: i32 = _bytes_check_write(dst, offset, 1);
    if (status != BYTES_OK) { return status; }
    deref dst.data[offset] = value;
    return BYTES_OK;
}

pub fun bytes_write_be_u16(dst: BytesMut, offset: i64, value: u16) -> i32 {
    var status: i32 = _bytes_check_write(dst, offset, 2);
    if (status != BYTES_OK) { return status; }
    bytes_store_be_u16(dst.data + offset, value);
    return BYTES_OK;
}

pub fun bytes_write_le_u16(dst: BytesMut, offset: i64, value: u16) -> i32 {
    var status: i32 = _bytes_check_write(dst, offset, 2);
    if (status != BYTES_OK) { return status; }
    bytes_store_le_u16(dst.data + offset, value);
    return BYTES_OK;
}

pub fun bytes_write_be_u32(dst: BytesMut, offset: i64, value: u32) -> i32 {
    var status: i32 = _bytes_check_write(dst, offset, 4);
    if (status != BYTES_OK) { return status; }
    bytes_store_be_u32(dst.data + offset, value);
    return BYTES_OK;
}

pub fun bytes_write_le_u32(dst: BytesMut, offset: i64, value: u32) -> i32 {
    var status: i32 = _bytes_check_write(dst, offset, 4);
    if (status != BYTES_OK) { return status; }
