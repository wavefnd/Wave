// Fallible TCP listeners and streams. A successful constructor transfers one
// owned socket to the returned wrapper; close consumes that ownership by convention.

import("std::sys::socket")::{listen, SHUT_RD, SHUT_WR, SHUT_RDWR};
import("std::net::address")::{
    NET_ADDRESS_IPV4, NET_ADDRESS_IPV6,
    SocketAddr, SocketAddrV4, SocketAddrV6, SocketAddrV4Result, SocketAddrV6Result,
    socket_addr_v4_any, socket_addr_v4_loopback,
    socket_addr_v6_any, socket_addr_v6_loopback,
    socket_addr_as_v4, socket_addr_as_v6,
};
import("std::net::error")::{
    NET_ERROR_TIMED_OUT, net_connect_pending,
    NetError, NetResult, NetIoResult,
    net_error, net_error_none, net_error_from_native,
    net_result_ok, net_result_err,
    net_io_ok, net_io_eof, net_io_error,
};
import("std::net::socket_base")::{
    net_fd_valid, net_set_reuseaddr,
    net_socket_tcp_v4, net_socket_tcp_v6,
    net_bind_socket_v4, net_bind_v6,
    net_connect_socket_v4, net_connect_v6,
    net_accept_socket_v4, net_accept_v6,
    net_local_addr_v4, net_peer_addr_v4,
    net_local_addr_v6, net_peer_addr_v6,
    net_send_once, net_recv_once, net_send_all, net_recv_exact,
    net_send_all_io, net_recv_exact_io,
    net_shutdown, net_close,
};
#[target(os="linux")]
import("std::net::posix_timeout")::{net_io_timeout};
#[target(os="macos")]
import("std::net::posix_timeout")::{net_io_timeout};
#[target(os="freebsd")]
import("std::net::posix_timeout")::{net_io_timeout};
#[target(os="windows")]
import("std::net::windows_timeout")::{net_io_timeout};
import("std::net::poll")::{net_wait_readable, net_wait_writable, net_wait_connected};
import("std::net::vectored")::{NetIoSlice, net_send_vectored, net_recv_vectored};
import("std::net::socketopt")::{
    net_set_nonblock, net_get_nonblock,
    net_set_tcp_nodelay, net_get_tcp_nodelay,
    net_set_keepalive, net_get_keepalive,
    net_set_recv_buffer, net_get_recv_buffer,
    net_set_send_buffer, net_get_send_buffer,
};
import("std::string::len")::{len};

pub struct TcpListener {
    fd: i64;
}

pub struct TcpStream {
    fd: i64;
}

fun _tcp_listener_error(native_code: i64) -> NetResult<TcpListener> {
    return net_result_err<TcpListener>(
        TcpListener { fd: -1 }, net_error_from_native(native_code)
    );
}

fun _tcp_stream_error(native_code: i64) -> NetResult<TcpStream> {
    return net_result_err<TcpStream>(
        TcpStream { fd: -1 }, net_error_from_native(native_code)
    );
}

fun _tcp_finish_listen(fd: i64, backlog: i32) -> NetResult<TcpListener> {
    if (backlog < 0) {
        net_close(fd);
        return _tcp_listener_error(-22);
    }
    var result: i64 = listen(fd, backlog);
    if (result < 0) {
        net_close(fd);
        return _tcp_listener_error(result);
    }
    return net_result_ok<TcpListener>(TcpListener { fd: fd });
}

pub fun tcp_listen_v4(addr: SocketAddrV4, backlog: i32) -> NetResult<TcpListener> {
    var fd: i64 = net_socket_tcp_v4();
    if (fd < 0) { return _tcp_listener_error(fd); }

    var result: i64 = net_set_reuseaddr(fd);
    if (result < 0) {
        net_close(fd);
        return _tcp_listener_error(result);
    }
    result = net_bind_socket_v4(fd, addr);
    if (result < 0) {
        net_close(fd);
        return _tcp_listener_error(result);
    }
    return _tcp_finish_listen(fd, backlog);
}

pub fun tcp_listen_v6(addr: SocketAddrV6, backlog: i32) -> NetResult<TcpListener> {
    var fd: i64 = net_socket_tcp_v6();
    if (fd < 0) { return _tcp_listener_error(fd); }

    var result: i64 = net_set_reuseaddr(fd);
    if (result < 0) {
        net_close(fd);
        return _tcp_listener_error(result);
    }
    result = net_bind_v6(fd, addr);
    if (result < 0) {
        net_close(fd);
        return _tcp_listener_error(result);
    }
    return _tcp_finish_listen(fd, backlog);
}

pub fun tcp_bind(port: u16) -> NetResult<TcpListener> {
    return tcp_listen_v4(socket_addr_v4_any(port), 128);
}

pub fun tcp_bind_loopback(port: u16) -> NetResult<TcpListener> {
    return tcp_listen_v4(socket_addr_v4_loopback(port), 128);
}

pub fun tcp_bind_v6(port: u16) -> NetResult<TcpListener> {
    return tcp_listen_v6(socket_addr_v6_any(port), 128);
}

pub fun tcp_bind_v6_loopback(port: u16) -> NetResult<TcpListener> {
    return tcp_listen_v6(socket_addr_v6_loopback(port), 128);
}

pub fun tcp_accept(listener: TcpListener) -> NetResult<TcpStream> {
    var accepted: i64 = net_accept_socket_v4(listener.fd, null);
    if (accepted < 0) { return _tcp_stream_error(accepted); }
    return net_result_ok<TcpStream>(TcpStream { fd: accepted });
}

pub fun tcp_accept_from_v4(
    listener: TcpListener, peer: ptr<SocketAddrV4>
) -> NetResult<TcpStream> {
    var accepted: i64 = net_accept_socket_v4(listener.fd, peer);
    if (accepted < 0) { return _tcp_stream_error(accepted); }
    return net_result_ok<TcpStream>(TcpStream { fd: accepted });
}

pub fun tcp_accept_from_v6(
    listener: TcpListener, peer: ptr<SocketAddrV6>
) -> NetResult<TcpStream> {
    var accepted: i64 = net_accept_v6(listener.fd, peer);
    if (accepted < 0) { return _tcp_stream_error(accepted); }
    return net_result_ok<TcpStream>(TcpStream { fd: accepted });
}

pub fun tcp_connect(addr: SocketAddrV4) -> NetResult<TcpStream> {
    var fd: i64 = net_socket_tcp_v4();
    if (fd < 0) { return _tcp_stream_error(fd); }
    var result: i64 = net_connect_socket_v4(fd, addr);
    if (result < 0) {
        net_close(fd);
        return _tcp_stream_error(result);
    }
    return net_result_ok<TcpStream>(TcpStream { fd: fd });
}

pub fun tcp_connect_v6(addr: SocketAddrV6) -> NetResult<TcpStream> {
    var fd: i64 = net_socket_tcp_v6();
    if (fd < 0) { return _tcp_stream_error(fd); }
    var result: i64 = net_connect_v6(fd, addr);
    if (result < 0) {
        net_close(fd);
        return _tcp_stream_error(result);
    }
    return net_result_ok<TcpStream>(TcpStream { fd: fd });
}

pub fun tcp_connect_addr(addr: SocketAddr) -> NetResult<TcpStream> {
    if (addr.ip.family == NET_ADDRESS_IPV4) {
        var ipv4: SocketAddrV4Result = socket_addr_as_v4(addr);
        if (!ipv4.ok) { return _tcp_stream_error(-22); }
        return tcp_connect(ipv4.value);
    }
    if (addr.ip.family == NET_ADDRESS_IPV6) {
        var ipv6: SocketAddrV6Result = socket_addr_as_v6(addr);
        if (!ipv6.ok) { return _tcp_stream_error(-22); }
        return tcp_connect_v6(ipv6.value);
    }
    return _tcp_stream_error(-22);
}

fun _tcp_connect_pending(result: i64) -> bool {
    return net_connect_pending(result);
}

fun _tcp_finish_connect_timeout(fd: i64, result: i64, timeout_ms: i32) -> NetResult<TcpStream> {
    if (result < 0 && !_tcp_connect_pending(result)) {
        net_close(fd);
        return _tcp_stream_error(result);
    }

    if (result < 0) {
        var completion: i64 = net_wait_connected(fd, timeout_ms);
        if (completion == 0) {
            net_close(fd);
            return net_result_err<TcpStream>(
                TcpStream { fd: -1 }, net_error(NET_ERROR_TIMED_OUT, 0)
            );
        }
        if (completion < 0) {
            net_close(fd);
            return _tcp_stream_error(completion);
        }
    }

    var blocking: i64 = net_set_nonblock(fd, 0);
    if (blocking < 0) {
        net_close(fd);
        return _tcp_stream_error(blocking);
    }
    return net_result_ok<TcpStream>(TcpStream { fd: fd });
}

pub fun tcp_connect_timeout(
    addr: SocketAddrV4, timeout_ms: i32
) -> NetResult<TcpStream> {
    if (timeout_ms < 0) { return _tcp_stream_error(-22); }
    var fd: i64 = net_socket_tcp_v4();
    if (fd < 0) { return _tcp_stream_error(fd); }
    var mode: i64 = net_set_nonblock(fd, 1);
    if (mode < 0) {
        net_close(fd);
        return _tcp_stream_error(mode);
    }
    return _tcp_finish_connect_timeout(fd, net_connect_socket_v4(fd, addr), timeout_ms);
}

pub fun tcp_connect_v6_timeout(
    addr: SocketAddrV6, timeout_ms: i32
) -> NetResult<TcpStream> {
    if (timeout_ms < 0) { return _tcp_stream_error(-22); }
    var fd: i64 = net_socket_tcp_v6();
    if (fd < 0) { return _tcp_stream_error(fd); }
    var mode: i64 = net_set_nonblock(fd, 1);
    if (mode < 0) {
        net_close(fd);
        return _tcp_stream_error(mode);
    }
    return _tcp_finish_connect_timeout(fd, net_connect_v6(fd, addr), timeout_ms);
}

pub fun tcp_connect_addr_timeout(
    addr: SocketAddr, timeout_ms: i32
) -> NetResult<TcpStream> {
    if (addr.ip.family == NET_ADDRESS_IPV4) {
        var ipv4: SocketAddrV4Result = socket_addr_as_v4(addr);
        if (!ipv4.ok) { return _tcp_stream_error(-22); }
        return tcp_connect_timeout(ipv4.value, timeout_ms);
    }
    if (addr.ip.family == NET_ADDRESS_IPV6) {
        var ipv6: SocketAddrV6Result = socket_addr_as_v6(addr);
        if (!ipv6.ok) { return _tcp_stream_error(-22); }
        return tcp_connect_v6_timeout(ipv6.value, timeout_ms);
    }
    return _tcp_stream_error(-22);
}

pub fun tcp_listener_local_addr_v4(listener: TcpListener) -> NetResult<SocketAddrV4> {
    var addr: SocketAddrV4 = socket_addr_v4_any(0);
    var result: i64 = net_local_addr_v4(listener.fd, &addr);
    if (result < 0) {
        return net_result_err<SocketAddrV4>(addr, net_error_from_native(result));
    }
    return net_result_ok<SocketAddrV4>(addr);
}

pub fun tcp_stream_local_addr_v4(stream: TcpStream) -> NetResult<SocketAddrV4> {
    var addr: SocketAddrV4 = socket_addr_v4_any(0);
    var result: i64 = net_local_addr_v4(stream.fd, &addr);
    if (result < 0) {
        return net_result_err<SocketAddrV4>(addr, net_error_from_native(result));
    }
    return net_result_ok<SocketAddrV4>(addr);
}

pub fun tcp_stream_peer_addr_v4(stream: TcpStream) -> NetResult<SocketAddrV4> {
    var addr: SocketAddrV4 = socket_addr_v4_any(0);
    var result: i64 = net_peer_addr_v4(stream.fd, &addr);
    if (result < 0) {
        return net_result_err<SocketAddrV4>(addr, net_error_from_native(result));
    }
    return net_result_ok<SocketAddrV4>(addr);
}

pub fun tcp_listener_local_addr_v6(listener: TcpListener) -> NetResult<SocketAddrV6> {
    var addr: SocketAddrV6 = socket_addr_v6_any(0);
    var result: i64 = net_local_addr_v6(listener.fd, &addr);
    if (result < 0) {
        return net_result_err<SocketAddrV6>(addr, net_error_from_native(result));
    }
    return net_result_ok<SocketAddrV6>(addr);
}

pub fun tcp_stream_local_addr_v6(stream: TcpStream) -> NetResult<SocketAddrV6> {
    var addr: SocketAddrV6 = socket_addr_v6_any(0);
    var result: i64 = net_local_addr_v6(stream.fd, &addr);
    if (result < 0) {
        return net_result_err<SocketAddrV6>(addr, net_error_from_native(result));
    }
    return net_result_ok<SocketAddrV6>(addr);
}

pub fun tcp_stream_peer_addr_v6(stream: TcpStream) -> NetResult<SocketAddrV6> {
    var addr: SocketAddrV6 = socket_addr_v6_any(0);
    var result: i64 = net_peer_addr_v6(stream.fd, &addr);
    if (result < 0) {
        return net_result_err<SocketAddrV6>(addr, net_error_from_native(result));
    }
    return net_result_ok<SocketAddrV6>(addr);
}

pub fun tcp_read(stream: TcpStream, buf: ptr<u8>, size: i64) -> i64 {
    return net_recv_once(stream.fd, buf, size, 0);
}

pub fun tcp_write(stream: TcpStream, buf: ptr<u8>, size: i64) -> i64 {
    return net_send_once(stream.fd, buf, size, 0);
}

pub fun tcp_write_all(stream: TcpStream, buf: ptr<u8>, size: i64) -> i64 {
    return net_send_all(stream.fd, buf, size, 0);
}

pub fun tcp_read_exact(stream: TcpStream, buf: ptr<u8>, size: i64) -> i64 {
    return net_recv_exact(stream.fd, buf, size, 0);
}

pub fun tcp_read_result(stream: TcpStream, buf: ptr<u8>, size: i64) -> NetIoResult {
    if (size == 0) { return net_io_ok(0); }
    var count: i64 = tcp_read(stream, buf, size);
    if (count > 0) { return net_io_ok(count); }
    if (count == 0) { return net_io_eof(0); }
    return net_io_error(0, count);
}

pub fun tcp_wait_read(stream: TcpStream, timeout_ms: i32) -> NetError {
    if (timeout_ms < -1) { return net_error_from_native(-22); }
    var ready: i64 = net_wait_readable(stream.fd, timeout_ms);
    if (ready > 0) { return net_error_none(); }
    if (ready == 0) { return net_error(NET_ERROR_TIMED_OUT, 0); }
    return net_error_from_native(ready);
}

pub fun tcp_wait_write(stream: TcpStream, timeout_ms: i32) -> NetError {
    if (timeout_ms < -1) { return net_error_from_native(-22); }
    var ready: i64 = net_wait_writable(stream.fd, timeout_ms);
    if (ready > 0) { return net_error_none(); }
    if (ready == 0) { return net_error(NET_ERROR_TIMED_OUT, 0); }
    return net_error_from_native(ready);
}

// These timeout helpers bound both readiness and the subsequent I/O attempt.
// Use the returned count to continue partial protocol reads or writes.
// On Windows, imported sockets must support overlapped I/O, as socket() does.
// A timeout cannot undo transmitted bytes. On cancellation errors, Winsock
// exposes no partial count; count contains only confirmed completed bytes.
pub fun tcp_read_timeout(
    stream: TcpStream, buf: ptr<u8>, size: i64, timeout_ms: i32
) -> NetIoResult {
    if (size < 0 || (buf == null && size > 0) || timeout_ms < -1) {
        return net_io_error(0, -22);
    }
    if (size == 0) { return net_io_ok(0); }
    return net_io_timeout(stream.fd, buf, size, timeout_ms, false);
}

pub fun tcp_write_timeout(
    stream: TcpStream, buf: ptr<u8>, size: i64, timeout_ms: i32
) -> NetIoResult {
    if (size < 0 || (buf == null && size > 0) || timeout_ms < -1) {
        return net_io_error(0, -22);
    }
    if (size == 0) { return net_io_ok(0); }
    return net_io_timeout(stream.fd, buf, size, timeout_ms, true);
}

pub fun tcp_write_result(stream: TcpStream, buf: ptr<u8>, size: i64) -> NetIoResult {
    var count: i64 = tcp_write(stream, buf, size);
    if (count >= 0) { return net_io_ok(count); }
    return net_io_error(0, count);
}

pub fun tcp_write_all_result(stream: TcpStream, buf: ptr<u8>, size: i64) -> NetIoResult {
    return net_send_all_io(stream.fd, buf, size, 0);
}

pub fun tcp_read_exact_result(stream: TcpStream, buf: ptr<u8>, size: i64) -> NetIoResult {
    return net_recv_exact_io(stream.fd, buf, size, 0);
}

pub fun tcp_write_vectored(
    stream: TcpStream, slices: ptr<NetIoSlice>, count: i32
) -> NetIoResult {
    return net_send_vectored(stream.fd, slices, count, 0);
}

pub fun tcp_read_vectored(
    stream: TcpStream, slices: ptr<NetIoSlice>, count: i32
) -> NetIoResult {
    return net_recv_vectored(stream.fd, slices, count, 0, true);
}

pub fun tcp_write_str(stream: TcpStream, text: str) -> NetIoResult {
    var size: i64 = len(text) as i64;
    return tcp_write_all_result(stream, text as ptr<u8>, size);
}

pub fun tcp_shutdown_read(stream: TcpStream) -> NetError {
    var result: i64 = net_shutdown(stream.fd, SHUT_RD);
    if (result < 0) { return net_error_from_native(result); }
    return net_error_none();
}

pub fun tcp_shutdown_write(stream: TcpStream) -> NetError {
    var result: i64 = net_shutdown(stream.fd, SHUT_WR);
    if (result < 0) { return net_error_from_native(result); }
    return net_error_none();
}

pub fun tcp_shutdown_both(stream: TcpStream) -> NetError {
    var result: i64 = net_shutdown(stream.fd, SHUT_RDWR);
    if (result < 0) { return net_error_from_native(result); }
    return net_error_none();
}

pub fun tcp_stream_set_nonblock(stream: TcpStream, enabled: bool) -> NetError {
    var result: i64 = net_set_nonblock(stream.fd, enabled as i32);
    if (result < 0) { return net_error_from_native(result); }
    return net_error_none();
}

pub fun tcp_listener_set_nonblock(listener: TcpListener, enabled: bool) -> NetError {
    var result: i64 = net_set_nonblock(listener.fd, enabled as i32);
    if (result < 0) { return net_error_from_native(result); }
    return net_error_none();
}

pub fun tcp_stream_is_nonblock(stream: TcpStream) -> NetResult<bool> {
    var result: i64 = net_get_nonblock(stream.fd);
    if (result < 0) {
        return net_result_err<bool>(false, net_error_from_native(result));
    }
    return net_result_ok<bool>(result != 0);
}

pub fun tcp_listener_is_nonblock(listener: TcpListener) -> NetResult<bool> {
    var result: i64 = net_get_nonblock(listener.fd);
    if (result < 0) {
        return net_result_err<bool>(false, net_error_from_native(result));
    }
    return net_result_ok<bool>(result != 0);
}

fun _tcp_option_error(result: i64) -> NetError {
    if (result < 0) { return net_error_from_native(result); }
    return net_error_none();
}

fun _tcp_option_bool(result: i64) -> NetResult<bool> {
    if (result < 0) {
        return net_result_err<bool>(false, net_error_from_native(result));
    }
    return net_result_ok<bool>(result != 0);
}

fun _tcp_option_i64(result: i64) -> NetResult<i64> {
    if (result < 0) {
        return net_result_err<i64>(0, net_error_from_native(result));
    }
    return net_result_ok<i64>(result);
}

pub fun tcp_set_nodelay(stream: TcpStream, enabled: bool) -> NetError {
    return _tcp_option_error(net_set_tcp_nodelay(stream.fd, enabled));
}

pub fun tcp_nodelay(stream: TcpStream) -> NetResult<bool> {
    return _tcp_option_bool(net_get_tcp_nodelay(stream.fd));
}

pub fun tcp_set_keepalive(stream: TcpStream, enabled: bool) -> NetError {
    return _tcp_option_error(net_set_keepalive(stream.fd, enabled));
}

pub fun tcp_keepalive(stream: TcpStream) -> NetResult<bool> {
    return _tcp_option_bool(net_get_keepalive(stream.fd));
}

pub fun tcp_set_recv_buffer(stream: TcpStream, size: i32) -> NetError {
    return _tcp_option_error(net_set_recv_buffer(stream.fd, size));
}

pub fun tcp_recv_buffer(stream: TcpStream) -> NetResult<i64> {
    return _tcp_option_i64(net_get_recv_buffer(stream.fd));
}

pub fun tcp_set_send_buffer(stream: TcpStream, size: i32) -> NetError {
    return _tcp_option_error(net_set_send_buffer(stream.fd, size));
}

pub fun tcp_send_buffer(stream: TcpStream) -> NetResult<i64> {
    return _tcp_option_i64(net_get_send_buffer(stream.fd));
}

// from_fd takes ownership of a valid platform socket handle.
pub fun tcp_from_fd(fd: i64) -> NetResult<TcpStream> {
    if (!net_fd_valid(fd)) { return _tcp_stream_error(-22); }
    return net_result_ok<TcpStream>(TcpStream { fd: fd });
}

pub fun tcp_listener_from_fd(fd: i64) -> NetResult<TcpListener> {
    if (!net_fd_valid(fd)) { return _tcp_listener_error(-22); }
    return net_result_ok<TcpListener>(TcpListener { fd: fd });
}

pub fun tcp_stream_valid(stream: TcpStream) -> bool { return net_fd_valid(stream.fd); }
pub fun tcp_listener_valid(listener: TcpListener) -> bool { return net_fd_valid(listener.fd); }

pub fun tcp_close(stream: TcpStream) -> NetError {
    var result: i64 = net_close(stream.fd);
    if (result < 0) { return net_error_from_native(result); }
    return net_error_none();
}

pub fun tcp_close_listener(listener: TcpListener) -> NetError {
    var result: i64 = net_close(listener.fd);
    if (result < 0) { return net_error_from_native(result); }
    return net_error_none();
}
