    if (sock.family != NET_ADDRESS_IPV6) {
        return net_result_err<bool>(false, net_error_from_native(-22));
    }
    return _udp_option_bool(net_get_multicast_loop_v6(sock.fd));
}

// from_fd takes ownership of a valid platform socket handle.
pub fun udp_from_fd(fd: i64, family: i32) -> NetResult<UdpSocket> {
    if (!net_fd_valid(fd) || (family != 4 && family != 6)) { return _udp_error(-22); }
    return net_result_ok<UdpSocket>(UdpSocket { fd: fd, family: family });
}

pub fun udp_socket_valid(sock: UdpSocket) -> bool { return net_fd_valid(sock.fd); }

pub fun udp_close(sock: UdpSocket) -> NetError {
    var result: i64 = net_close(sock.fd);
    if (result < 0) { return net_error_from_native(result); }
    return net_error_none();
}

// Extended receive APIs expose datagram truncation. Existing APIs retain their
// count-only contracts; callers requiring completeness must use these results.
pub fun udp_recv_datagram(sock: UdpSocket, buf: ptr<u8>, size: i64) -> NetDatagramResult {
    var slice: NetIoSlice = NetIoSlice { data: buf, length: size };
    return net_recv_vectored_datagram(sock.fd, &slice, 1);
}

pub fun udp_recv_vectored_datagram(sock: UdpSocket, slices: ptr<NetIoSlice>, count: i32) -> NetDatagramResult {
    return net_recv_vectored_datagram(sock.fd, slices, count);
}
