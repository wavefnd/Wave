pub import("std::math::constants")::{
    MATH_PI_F32,
    MATH_TWO_PI_F32,
    MATH_HALF_PI_F32,
    MATH_QUARTER_PI_F32,
    MATH_PI_F64,
    MATH_TWO_PI_F64,
    MATH_HALF_PI_F64,
    MATH_QUARTER_PI_F64,
};
pub import("std::math::float")::{
    abs_f32,
    abs_f64,
    sqrt_f32,
    sqrt_f64,
    is_finite_f64,
    nan_f64,
};

import("std::math::trig_reduction")::{ReducedAngle, reduce_angle_f64};

pub struct SinCosF32 {
    sin: f32;
    cos: f32;
}

pub struct SinCosF64 {
    sin: f64;
    cos: f64;
}

// Reduces a finite angle to [-pi, pi] without an out-of-range float-to-int cast.
pub fun wrap_angle_pi_f64(value: f64) -> f64 {
    if (!is_finite_f64(value)) {
        return nan_f64();
    }

    var angle: ReducedAngle = reduce_angle_f64(value);
    var r: f64 = angle.remainder;
    if (angle.quadrant == 0) { return r; }
    if (angle.quadrant == 1) { return MATH_HALF_PI_F64 + r; }
    if (angle.quadrant == 3) { return -MATH_HALF_PI_F64 + r; }
    if (r <= 0.0) { return MATH_PI_F64 + r; }
    return -MATH_PI_F64 + r;
}

pub fun wrap_angle_pi_f32(value: f32) -> f32 {
    return wrap_angle_pi_f64(value as f64) as f32;
}

fun sin_polynomial_f64(value: f64) -> f64 {
    var x2: f64 = value * value;
    var x3: f64 = value * x2;
    var x5: f64 = x3 * x2;
    var x7: f64 = x5 * x2;
    var x9: f64 = x7 * x2;
    var x11: f64 = x9 * x2;
    var x13: f64 = x11 * x2;
    return value
         - x3 / 6.0
         + x5 / 120.0
         - x7 / 5040.0
         + x9 / 362880.0
         - x11 / 39916800.0
         + x13 / 6227020800.0;
}

fun cos_polynomial_f64(value: f64) -> f64 {
    var x2: f64 = value * value;
    var x4: f64 = x2 * x2;
    var x6: f64 = x4 * x2;
    var x8: f64 = x6 * x2;
    var x10: f64 = x8 * x2;
    var x12: f64 = x10 * x2;
    var x14: f64 = x12 * x2;
    return 1.0
         - x2 / 2.0
         + x4 / 24.0
         - x6 / 720.0
         + x8 / 40320.0
         - x10 / 3628800.0
         + x12 / 479001600.0
         - x14 / 87178291200.0;
}

pub fun sin_f64(value: f64) -> f64 {
    return sin_cos_f64(value).sin;
}

pub fun cos_f64(value: f64) -> f64 {
    return sin_cos_f64(value).cos;
}

pub fun tan_f64(value: f64) -> f64 {
    var result: SinCosF64 = sin_cos_f64(value);
    return result.sin / result.cos;
}

pub fun sin_f32(value: f32) -> f32 {
    return sin_f64(value as f64) as f32;
}

pub fun cos_f32(value: f32) -> f32 {
    return cos_f64(value as f64) as f32;
}

pub fun tan_f32(value: f32) -> f32 {
    return tan_f64(value as f64) as f32;
}

pub fun sin_cos_f64(value: f64) -> SinCosF64 {
    if (!is_finite_f64(value)) {
        return SinCosF64 { sin: nan_f64(), cos: nan_f64() };
    }
    // Avoid cancellation of -0 in the polynomial, and unnecessary underflow.
    if (abs_f64(value) < 0.000000007450580596923828125) {
        return SinCosF64 { sin: value, cos: 1.0 };
    }
    var angle: ReducedAngle = reduce_angle_f64(value);
    var s: f64 = sin_polynomial_f64(angle.remainder);
    var c: f64 = cos_polynomial_f64(angle.remainder);
    if (angle.quadrant == 0) { return SinCosF64 { sin: s, cos: c }; }
    if (angle.quadrant == 1) { return SinCosF64 { sin: c, cos: -s }; }
    if (angle.quadrant == 2) { return SinCosF64 { sin: -s, cos: -c }; }
    return SinCosF64 { sin: -c, cos: s };
}

pub fun sin_cos_f32(value: f32) -> SinCosF32 {
    var result: SinCosF64 = sin_cos_f64(value as f64);
    return SinCosF32 { sin: result.sin as f32, cos: result.cos as f32 };
}

pub fun radians_f64(degrees: f64) -> f64 {
    return degrees * (MATH_PI_F64 / 180.0);
}

pub fun degrees_f64(radians: f64) -> f64 {
    return radians * (180.0 / MATH_PI_F64);
}

pub fun radians_f32(degrees: f32) -> f32 {
    return degrees * (MATH_PI_F32 / 180.0);
}

pub fun degrees_f32(radians: f32) -> f32 {
    return radians * (180.0 / MATH_PI_F32);
}
